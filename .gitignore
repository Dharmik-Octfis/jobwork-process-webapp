# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — NEVER commit secrets
# One file per deploy target PER SERVICE (backend/.env.staging, accounts/.env.staging,
# ...), each with its own database, secrets and Catalyst credentials. The rule is
# extension-based, so a new service folder is covered without editing this file.
.env
.env.*
!.env.example
!.env.production.example

# Generated by scripts/build-app-config.mjs from the target's env file.
# Carries real secrets in `env_variables`, so it must stay out of git.
# The committed template is each service's app-config.base.json.
# One line per service — a new service that forgets its line commits its secrets.
backend/app-config.json
accounts/app-config.json

# Generated by scripts/deploy.mjs from deploy/<target>.catalystrc.json — it now
# names whichever target you deployed last, so it is a local scratch file rather
# than a shared setting. The committed sources of truth are in deploy/.
.catalystrc

# Generated by scripts/deploy.mjs from deploy/services.json, holding only the ONE
# service being deployed — that is what stops `catalyst deploy --only appsail` from
# pushing every AppSail in the repo. Committing it would also re-freeze the AppSail
# name across both accounts, which is what per-target names exist to avoid.
catalyst.json

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.local

# Test coverage
coverage/