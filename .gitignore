# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — NEVER commit secrets
# Covers backend/.env.staging and backend/.env.production: one file per deploy
# target, each with its own database, JWT secrets and Catalyst credentials.
.env
.env.*
!.env.example
!.env.production.example

# Generated by scripts/build-app-config.mjs from the target's env file.
# Carries real secrets in `env_variables`, so it must stay out of git.
# The committed template is backend/app-config.base.json.
backend/app-config.json

# Generated by scripts/deploy.mjs from deploy/<target>.catalystrc.json — it now
# names whichever target you deployed last, so it is a local scratch file rather
# than a shared setting. The committed sources of truth are in deploy/.
.catalystrc

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.local

# Test coverage
coverage/