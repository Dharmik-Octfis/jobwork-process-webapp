# Clear a leftover MERGE_HEAD before git reads it, so a stale one cannot turn this commit into a
# bogus second merge commit -- and so the skip below only fires on a merge that is genuinely open.
sh scripts/clear-stale-merge-head.sh

# Skip lint-staged during a real merge: it backs up .git/MERGE_HEAD, stashes, then writes the buffer
# back, and an interrupted run restores it after git concluded the merge. Conflict resolutions go
# unlinted as a result -- run `npx prettier --write` by hand if a merge needed real editing.
if git rev-parse --verify --quiet MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# `if` so husky's `sh -e` cannot abort before the guard below: lint-staged writes MERGE_HEAD back
# from its buffer on the way out of a FAILED run (gitWorkflow.js restoreOriginalState -> reset
# --hard, then restoreMergeStatus), which is after every hook that could have caught it.
if npx --no-install lint-staged; then
  lint_status=0
else
  lint_status=$?
fi

sh scripts/clear-stale-merge-head.sh

exit $lint_status
