+          await postMovement(tx, {
+            organizationId,
+            lotId: lot.id,
+            locationId: locRow.locationId,
+            movementType: 'opening',
+            qtyIn: qty,
+            sourceDocType: 'item_opening_stock',
+            sourceDocId: itemId,
+            userId,
+          });
+        }
+      }
+
+      return this.readOpeningStockRowsFromTable(tx, itemId, organizationId);
+    });
+  }
