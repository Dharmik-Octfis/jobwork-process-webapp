+            committed_stock,
+            available_for_sale,
+            custom_fields,
+            is_deleted,
+            created_by,
+            updated_by,
+            created_at,
+            updated_at
+          ) VALUES (
+            gen_random_uuid(),
+            ${organizationId}::uuid,
+            ${itemId}::uuid,
+            ${locRow.locationId}::uuid,
+            ${openingStock},
+            0,
+            ${openingStock},
+            '{}'::jsonb,
+            false,
+            ${userId ?? null}::uuid,
+            ${userId ?? null}::uuid,
+            CURRENT_TIMESTAMP,
+            CURRENT_TIMESTAMP
+          )
+        `);
+
+        await tx.$executeRaw(Prisma.sql`
+          INSERT INTO item_opening_stock_rows (
+            id,
+            organization_id,
+            item_id,
+            location_id,
+            opening_stock,
+            opening_stock_value_per_unit,
+            batches,
+            custom_fields,
+            is_deleted,
+            created_by,
+            updated_by,
+            created_at,
+            updated_at
+          ) VALUES (
+            gen_random_uuid(),
+            ${organizationId}::uuid,
+            ${itemId}::uuid,
+            ${locRow.locationId}::uuid,
+            ${openingStock},
+            ${openingStockValuePerUnit},
+            ${JSON.stringify(batches)}::jsonb,
+            '{}'::jsonb,
+            false,
+            ${userId ?? null}::uuid,
+            ${userId ?? null}::uuid,
+            CURRENT_TIMESTAMP,
+            CURRENT_TIMESTAMP
+          )
+        `);
+
+        for (const batch of batches) {
+          const qty = Number(batch.quantityIn);
+          if (!qty || qty <= 0) continue;
+
+          const lot = await createLot(tx, {
+            organizationId,
+            itemId,
+            uomId: item.stockingUomId,
+            lotNumber: undefined,
+            supplierLotRef: batch.batchReference || null,
+            sourceDocType: 'item_opening_stock',
+            sourceDocId: itemId,
+            userId,
