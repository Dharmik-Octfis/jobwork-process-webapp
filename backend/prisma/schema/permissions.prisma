/// A job title, arranged in a **reporting hierarchy** since 2026-07-30.
///
/// 🔴 The hierarchy is STRUCTURE, NOT ACCESS. `parentRoleId` says who reports to
/// whom; it grants nothing, no middleware reads it, and no query filters by it.
/// What a member may do still comes only from their permission template. If you
/// ever find yourself wanting "a manager can see their subordinates' records",
/// that is a data-scoping feature that belongs in the query layer next to RLS —
/// it is not this column, and adding it here would quietly turn a labelling
/// exercise into an authorization system nobody audited.
model Role {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  description    String?      @db.VarChar(255)
  /// Who this title reports to. Null = a root of the tree (Owner always is).
  /// `Restrict` rather than `SetNull`/`Cascade`: silently re-parenting a subtree to
  /// the root — or deleting it — because someone removed a middle title is a
  /// reorganisation nobody asked for. `deleteRole` refuses while children exist.
  parentRoleId   String?      @map("parent_role_id") @db.Uuid
  isSystem       Boolean      @default(false) @map("is_system")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitations    Invitation[]
  memberships    Membership[]
  createdByUser  User?        @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("RoleUpdatedBy", fields: [updatedBy], references: [id])
  parent         Role?        @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: Restrict)
  children       Role[]       @relation("RoleHierarchy")

  /// 🔴 `(organization_id, name)` IS unique, but only across LIVE rows — the index
  /// is `WHERE is_deleted = false` and therefore cannot be written as `@@unique`
  /// here (Prisma has no partial-index syntax). It lives in
  /// `migrations/20260805130000_roles_partial_unique_name` and nowhere else, so
  /// **do not "restore" `@@unique([organizationId, name])`** — that re-creates the
  /// full index and a deleted title reserves its name again, forever. Postgres
  /// still raises 23505, which Prisma still reports as P2002, so
  /// `withUniqueViolation` in roles.service is unaffected.
  @@index([organizationId, isDeleted])
  @@index([organizationId, parentRoleId])
  @@map("roles")
}

model PermissionTemplate {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  name                 String       @db.VarChar(100)
  description          String?      @db.VarChar(255)
  isSystem             Boolean      @default(false) @map("is_system")
  permissions          String[]     @default([])
  isDeleted            Boolean      @default(false) @map("is_deleted")
  createdBy            String?      @map("created_by") @db.Uuid
  updatedBy            String?      @map("updated_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  grantsAllPermissions Boolean      @default(false) @map("grants_all_permissions")
  invitations          Invitation[]
  memberships          Membership[]
  createdByUser        User?        @relation("PermissionTemplateCreatedBy", fields: [createdBy], references: [id])
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser        User?        @relation("PermissionTemplateUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId, isDeleted])
  @@map("permission_templates")
}
