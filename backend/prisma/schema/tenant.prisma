model User {
  id                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                         String                  @unique @db.Citext
  passwordHash                  String?                 @map("password_hash")
  firstName                     String                  @default("") @map("first_name") @db.VarChar(40)
  lastName                      String                  @default("") @map("last_name") @db.VarChar(40)
  fullName                      String                  @default("") @map("full_name") @db.VarChar(80)
  isActive                      Boolean                 @default(true) @map("is_active")
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                     String?                 @map("created_by") @db.Uuid
  isDeleted                     Boolean                 @default(false) @map("is_deleted")
  updatedBy                     String?                 @map("updated_by") @db.Uuid
  createdCurrencies             Currency[]              @relation("CurrencyCreatedBy")
  updatedCurrencies             Currency[]              @relation("CurrencyUpdatedBy")
  createdCustomFieldDefinitions CustomFieldDefinition[] @relation("CustomFieldDefinitionCreatedBy")
  updatedCustomFieldDefinitions CustomFieldDefinition[] @relation("CustomFieldDefinitionUpdatedBy")
  createdCustomerActivities     CustomerActivity[]      @relation("CustomerActivityCreatedBy")
  updatedCustomerActivities     CustomerActivity[]      @relation("CustomerActivityUpdatedBy")
  createdCustomerAddresses      CustomerAddress[]       @relation("CustomerAddressCreatedBy")
  updatedCustomerAddresses      CustomerAddress[]       @relation("CustomerAddressUpdatedBy")
  createdCustomerComments       CustomerComment[]       @relation("CustomerCommentCreatedBy")
  updatedCustomerComments       CustomerComment[]       @relation("CustomerCommentUpdatedBy")
  createdCustomerContactPersons CustomerContactPerson[] @relation("CustomerContactPersonCreatedBy")
  updatedCustomerContactPersons CustomerContactPerson[] @relation("CustomerContactPersonUpdatedBy")
  createdCustomers              Customer[]              @relation("CustomerCreatedBy")
  updatedCustomers              Customer[]              @relation("CustomerUpdatedBy")
  createdInvitations            Invitation[]            @relation("InvitationCreatedBy")
  sentInvitations               Invitation[]            @relation("InvitedBy")
  updatedInvitations            Invitation[]            @relation("InvitationUpdatedBy")
  createdItemActivities         ItemActivity[]          @relation("ItemActivityCreatedBy")
  updatedItemActivities         ItemActivity[]          @relation("ItemActivityUpdatedBy")
  createdItems                  Item[]                  @relation("ItemCreatedBy")
  updatedItems                  Item[]                  @relation("ItemUpdatedBy")
  createdLocations              Location[]              @relation("LocationCreatedBy")
  updatedLocations              Location[]              @relation("LocationUpdatedBy")
  createdMemberships            Membership[]            @relation("MembershipCreatedBy")
  updatedMemberships            Membership[]            @relation("MembershipUpdatedBy")
  createdOrganizations          Organization[]          @relation("OrganizationCreatedBy")
  updatedOrganizations          Organization[]          @relation("OrganizationUpdatedBy")
  memberships                   Membership[]
  createdNumberSequences        NumberSequence[]        @relation("NumberSequenceCreatedBy")
  updatedNumberSequences        NumberSequence[]        @relation("NumberSequenceUpdatedBy")

  createdUnitsOfMeasurement     UnitOfMeasurement[]     @relation("UomCreatedBy")
  updatedUnitsOfMeasurement     UnitOfMeasurement[]     @relation("UomUpdatedBy")


  listViewPreferences           ListViewPreference[]    @relation("ListViewPreferenceUser")
  createdListViewPreferences    ListViewPreference[]    @relation("ListViewPreferenceCreatedBy")
  updatedListViewPreferences    ListViewPreference[]    @relation("ListViewPreferenceUpdatedBy")
  createdRoles                  Role[]                  @relation("RoleCreatedBy")
  updatedRoles                  Role[]                  @relation("RoleUpdatedBy")
  createdPermissionTemplates    PermissionTemplate[]    @relation("PermissionTemplateCreatedBy")
  updatedPermissionTemplates    PermissionTemplate[]    @relation("PermissionTemplateUpdatedBy")
  createdPaymentTerms           PaymentTerm[]           @relation("PaymentTermCreatedBy")
  updatedPaymentTerms           PaymentTerm[]           @relation("PaymentTermUpdatedBy")

  createdPoActivities         PurchaseOrderActivity[] @relation("PoActivityCreatedBy")
  updatedPoActivities         PurchaseOrderActivity[] @relation("PoActivityUpdatedBy")
  createdPoComments           PurchaseOrderComment[]  @relation("PoCommentCreatedBy")
  updatedPoComments           PurchaseOrderComment[]  @relation("PoCommentUpdatedBy")
  createdPurchaseOrderItems   PurchaseOrderItem[]     @relation("PoItemCreatedBy")
  updatedPurchaseOrderItems   PurchaseOrderItem[]     @relation("PoItemUpdatedBy")
  createdPurchaseOrders       PurchaseOrder[]         @relation("PoCreatedBy")
  updatedPurchaseOrders       PurchaseOrder[]         @relation("PoUpdatedBy")
  refreshTokens               RefreshToken[]
  createdByUser               User?                   @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers                User[]                  @relation("UserCreatedBy")
  updatedByUser               User?                   @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers                User[]                  @relation("UserUpdatedBy")
  createdVendorActivities     VendorActivity[]        @relation("VendorActivityCreatedBy")
  updatedVendorActivities     VendorActivity[]        @relation("VendorActivityUpdatedBy")
  createdVendorAddresses      VendorAddress[]         @relation("VendorAddressCreatedBy")
  updatedVendorAddresses      VendorAddress[]         @relation("VendorAddressUpdatedBy")
  createdVendorComments       VendorComment[]         @relation("VendorCommentCreatedBy")
  updatedVendorComments       VendorComment[]         @relation("VendorCommentUpdatedBy")
  createdVendorContactPersons VendorContactPerson[]   @relation("VendorContactPersonCreatedBy")
  updatedVendorContactPersons VendorContactPerson[]   @relation("VendorContactPersonUpdatedBy")
  createdVendors              Vendor[]                @relation("VendorCreatedBy")
  updatedVendors              Vendor[]                @relation("VendorUpdatedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("password_reset_tokens")
}

model Organization {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  phone                  String?
  email                  String?
  zip                    String?
  dialCode               String?                 @map("dial_code")
  orgAddress             String?                 @map("org_address")
  taxIdValue             String?                 @map("tax_id_value")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  industryCode           String?                 @map("industry_code") @db.VarChar(64)
  createdBy              String?                 @map("created_by") @db.Uuid
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  updatedBy              String?                 @map("updated_by") @db.Uuid
  stateCode              String?                 @map("state_code") @db.VarChar(6)
  cityId                 String?                 @map("city_id") @db.Uuid
  countryCode            String?                 @map("country_code") @db.VarChar(2)
  currencies             Currency[]
  customFieldDefinitions CustomFieldDefinition[]
  customers              Customer[]
  invitations            Invitation[]
  items                  Item[]
  locations              Location[]
  memberships            Membership[]
  numberSequences        NumberSequence[]
  city                   City?                   @relation(fields: [cityId], references: [id])
  country                Country?                @relation(fields: [countryCode], references: [code])
  createdByUser          User?                   @relation("OrganizationCreatedBy", fields: [createdBy], references: [id])
  industry               Industry?               @relation(fields: [industryCode], references: [code])
  state                  State?                  @relation(fields: [stateCode], references: [code])
  updatedByUser          User?                   @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id])
  paymentTerms           PaymentTerm[]
  listViewPreferences    ListViewPreference[]
  roles                  Role[]
  permissionTemplates    PermissionTemplate[]
  purchaseOrders         PurchaseOrder[]
  unitsOfMeasurement     UnitOfMeasurement[]
  vendors                Vendor[]

  @@map("organizations")
}

model Membership {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  // The org creator. Ownership is ABOVE the permission system: `tenantContext`
  // short-circuits an owner to every permission before it ever reads a template,
  // and `requireOwner` gates the handful of actions no template may grant
  // (deleting the org, transferring ownership). Replaced a `role` string that
  // stored one bit in a VARCHAR(50) — see the 2026-07-25 migration.
  //
  // Scoped to THIS organization: it never widens tenant scope. An owner of one
  // org is a stranger to every other, and RLS enforces that independently.
  isOwner              Boolean  @default(false) @map("is_owner")
  // The member's job title. Purely descriptive — no middleware reads it, so it
  // grants nothing (see permissions.prisma). Nullable: a member may have no title
  // yet, and every row predating the roles/permissions split has none. SetNull so
  // deleting a role never deletes memberships.
  roleId               String?  @map("role_id") @db.Uuid
  // The permission template that grants this membership its access. Nullable:
  // legacy rows created before this module predate it, and tenantContext falls
  // back to `role` (permissionsForRole) when it is null. SetNull, not Cascade —
  // deleting a template must never delete memberships (the service also blocks
  // deleting a template still in use).
  permissionTemplateId String?  @map("permission_template_id") @db.Uuid
  isDeleted            Boolean  @default(false) @map("is_deleted")
  createdBy            String?  @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role               Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permissionTemplate PermissionTemplate? @relation(fields: [permissionTemplateId], references: [id], onDelete: SetNull)

  createdByUser User? @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("MembershipUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Invitation {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  email                String    @db.Citext
  // The job title the invitee gets on accept. Optional — a title grants nothing,
  // so requiring one would block inviting for no security gain. Restrict: a role
  // with a pending invite cannot be deleted out from under it.
  roleId               String?   @map("role_id") @db.Uuid
  // The permission template the invitee gets on accept. Required — an org has no
  // default templates, so the Owner must create one before inviting anyone. The
  // Owner template itself is never invitable (enforced in the service): ownership
  // comes from creating the org, not from an invite.
  permissionTemplateId String    @map("permission_template_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  status               String    @default("pending") @db.VarChar(20) // pending | accepted | revoked | declined
  invitedById          String    @map("invited_by_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(6)
  declinedAt           DateTime? @map("declined_at") @db.Timestamptz(6)

  // Send throttling. The row is RECYCLED on re-invite (see @@unique below), so
  // there is no row-per-send to count — these two columns are the send record.
  // `lastSentAt` drives both the per-recipient cooldown and the per-org hourly cap.
  sendCount  Int       @default(0) @map("send_count")
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(6)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy          User               @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  role               Role?              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionTemplate PermissionTemplate @relation(fields: [permissionTemplateId], references: [id], onDelete: Restrict)

  createdByUser User? @relation("InvitationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("InvitationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId, lastSentAt])
  @@index([email])
  @@map("invitations")
}

model Industry {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @unique
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  code          String         @unique @db.VarChar(64)
  organizations Organization[]

  @@map("industries")
}

model Country {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @unique
  code          String         @unique @db.VarChar(2)
  isoCode       String         @unique @map("iso_code") @db.VarChar(3)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  dialCode      String         @map("dial_code") @db.VarChar(8)
  organizations Organization[]
  states        State[]

  @@map("countries")
}

model State {
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  code          String         @id @db.VarChar(6)
  countryCode   String         @map("country_code") @db.VarChar(2)
  cities        City[]
  organizations Organization[]
  country       Country        @relation(fields: [countryCode], references: [code])

  @@unique([countryCode, name])
  @@map("states")
}

model City {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  stateCode     String         @map("state_code") @db.VarChar(6)
  geonamesId    Int?           @unique @map("geonames_id")
  state         State          @relation(fields: [stateCode], references: [code], onDelete: Cascade)
  organizations Organization[]

  @@unique([name, stateCode])
  @@map("cities")
}

model AppModule {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(100)
  parentId  String?     @map("parent_id") @db.Uuid
  sortIndex Int         @default(0) @map("sort_index")
  icon      String?     @db.VarChar(50)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    AppModule?  @relation("ModuleToSubModules", fields: [parentId], references: [id], onDelete: Cascade)
  children  AppModule[] @relation("ModuleToSubModules")

  @@map("app_modules")
}

model NumberSequence {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(50)
  prefix         String       @db.VarChar(20)
  nextNumber     Int          @default(1) @map("next_number")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  isDeleted      Boolean      @default(false) @map("is_deleted")
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdByUser  User?        @relation("NumberSequenceCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("NumberSequenceUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, entityType])
  @@map("number_sequences")
}

model Currency {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  currencyCode   String       @map("currency_code")
  currencyName   String       @map("currency_name")
  symbol         String
  decimalPlaces  Int          @default(2) @map("decimal_places")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  format         String       @default("1,234,567.89")
  createdByUser  User?        @relation("CurrencyCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("CurrencyUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, currencyCode])
  @@map("currencies")
}

model PaymentTerm {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  termName       String       @map("term_name")
  dueAfterDays   Int          @map("due_after_days")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUser  User?        @relation("PaymentTermCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("PaymentTermUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, termName])
  @@map("payment_terms")
}

/// Per-user, per-organization column layout for one module's list view — which
/// columns are shown and in what order ("Customize Columns").
///
/// Per USER, not per org: a layout is a personal preference, so two members of
/// the same organization can see different columns. The unique key is
/// (user, organization, entityType).
///
/// No `custom_fields` column: this is a preferences row, not a domain entity an
/// org adds fields to (same exclusion reasoning as the token/reference tables).
/// Per-org custom FIELDS can still be *chosen* as columns — they're stored in
/// `columns` as `cf:<key>`.
model ListViewPreference {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  /// vendor | customer | item — the module whose list this layout belongs to.
  entityType String @map("entity_type") @db.VarChar(50)

  /// Ordered array of visible column keys; position in the array IS the column
  /// order. Built-in columns are plain keys ("displayName"); custom fields are
  /// prefixed ("cf:truck_no"). Locked columns are re-asserted server-side on
  /// save, so a tampered payload can't drop or move them.
  columns Json @default("[]")

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ListViewPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  createdByUser User? @relation("ListViewPreferenceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("ListViewPreferenceUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  /// One layout per user per module per org. Saves upsert onto this key (and set
  /// isDeleted:false), which is the documented way to live with soft-delete
  /// holding a unique key.
  @@unique([userId, organizationId, entityType])
  @@map("list_view_preferences")
}

model Location {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  name                   String
  addressString          String?         @map("address_string")
  isDeleted              Boolean         @default(false) @map("is_deleted")
  createdBy              String?         @map("created_by") @db.Uuid
  updatedBy              String?         @map("updated_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  city                   String?
  country                String?
  logo                   String?
  parentId               String?         @map("parent_id") @db.Uuid
  phone                  String?
  state                  String?
  street1                String?
  street2                String?
  type                   String          @default("Business")
  zip                    String?
  createdByUser          User?           @relation("LocationCreatedBy", fields: [createdBy], references: [id])
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentLocation         Location?       @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  childLocations         Location[]      @relation("LocationHierarchy")
  updatedByUser          User?           @relation("LocationUpdatedBy", fields: [updatedBy], references: [id])
  deliveryPurchaseOrders PurchaseOrder[]
  sourcePurchaseOrders   PurchaseOrder[] @relation("PoSourceLocation")

  @@unique([organizationId, name])
  @@map("locations")
}
