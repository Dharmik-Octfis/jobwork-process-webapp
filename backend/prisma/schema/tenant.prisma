/// Per-user, per-organization column layout for one module's list view — which
/// columns are shown and in what order ("Customize Columns").
///
/// Per USER, not per org: a layout is a personal preference, so two members of
/// the same organization can see different columns. The unique key is
/// (user, organization, entityType).
///
/// No `custom_fields` column: this is a preferences row, not a domain entity an
/// org adds fields to (same exclusion reasoning as the token/reference tables).
/// Per-org custom FIELDS can still be *chosen* as columns — they're stored in
/// `columns` as `cf:<key>`.
model ListViewPreference {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  /// vendor | customer | item — the module whose list this layout belongs to.
  entityType     String       @map("entity_type") @db.VarChar(50)
  /// Ordered array of visible column keys; position in the array IS the column
  /// order. Built-in columns are plain keys ("displayName"); custom fields are
  /// prefixed ("cf:truck_no"). Locked columns are re-asserted server-side on
  /// save, so a tampered payload can't drop or move them.
  columns        Json         @default("[]")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUser  User?        @relation("ListViewPreferenceCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("ListViewPreferenceUpdatedBy", fields: [updatedBy], references: [id])
  user           User         @relation("ListViewPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, entityType])
  @@map("list_view_preferences")
}

model Location {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                   @map("organization_id") @db.Uuid
  name                     String
  addressString            String?                  @map("address_string")
  isPrimary                Boolean                  @default(false) @map("is_primary")
  isDeleted                Boolean                  @default(false) @map("is_deleted")
  createdBy                String?                  @map("created_by") @db.Uuid
  updatedBy                String?                  @map("updated_by") @db.Uuid
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  city                     String?
  country                  String?
  logo                     String?
  parentId                 String?                  @map("parent_id") @db.Uuid
  phone                    String?
  state                    String?
  street1                  String?
  street2                  String?
  /// Business | Warehouse | godown | shopfloor | work_centre | processor |
  /// in_transit | customer_site
  ///
  /// The last five arrived with jobwork (domain doc §5.4). Goods at a processor
  /// are OUR stock at THEIR location — one axis, not a location plus a separate
  /// "with-processor" state — which is what makes "stock lying with processors" a
  /// plain ledger query grouped by location and aged by movement date. That report
  /// is not a nicety: Indian GST reverses the input credit if jobwork goods do not
  /// come back within 180/365 days.
  type                     String                   @default("Business")
  /// The jobworker a `processor` location stands for. Auto-provisioned the first
  /// time a vendor is used for jobwork, so nobody has to create the location by
  /// hand before they can issue material to them.
  vendorId                 String?                  @map("vendor_id") @db.Uuid
  zip                      String?
  createdByUser            User?                    @relation("LocationCreatedBy", fields: [createdBy], references: [id])
  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentLocation           Location?                @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  childLocations           Location[]               @relation("LocationHierarchy")
  updatedByUser            User?                    @relation("LocationUpdatedBy", fields: [updatedBy], references: [id])
  vendor                   Vendor?                  @relation("LocationVendor", fields: [vendorId], references: [id])
  deliveryPurchaseOrders   PurchaseOrder[]
  sourcePurchaseOrders     PurchaseOrder[]          @relation("PoSourceLocation")
  bills                    Bill[]                   @relation("BillLocation")
  ledgerEntries            StockLedgerEntry[]       @relation("StockLedgerLocation")
  routeStepWorkCentres     RouteStep[]              @relation("RouteStepWorkCentre")
  jobOrderStepWorkCentres  JobOrderStep[]           @relation("JobOrderStepWorkCentre")
  jobIssuesFrom            JobIssue[]               @relation("JobIssueSource")
  jobIssuesTo              JobIssue[]               @relation("JobIssueDestination")
  jobIssueLinesFrom        JobIssueLine[]           @relation("JobIssueLineSource")
  jobReceipts              JobReceipt[]             @relation("JobReceiptLocation")
  itemAssemblies           ItemAssembly[]           @relation("ItemAssemblyLocation")
  itemOpeningStockRows     ItemOpeningStockRow[]
  jobOrderStepInputBatches JobOrderStepInputBatch[] @relation("JobOrderStepInputBatchLocation")

  @@unique([organizationId, name])
  @@map("locations")
}
