// Tenant domain: Organization, User, Membership, Invitation (architecture §4).
// Only User exists so far. See docs/PRISMA.md §4.3 for why each attribute is here.

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String  @unique @db.Citext
  passwordHash String? @map("password_hash")
  firstName    String  @default("") @map("first_name") @db.VarChar(40)
  lastName     String  @default("") @map("last_name") @db.VarChar(40)
  fullName     String  @default("") @map("full_name") @db.VarChar(80)
  isActive     Boolean @default(true) @map("is_active")

  // Standard audit columns — see CLAUDE.md "Default columns". createdBy/updatedBy
  // are self-referential here (the actor is also a User).
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens   RefreshToken[]
  memberships     Membership[]
  sentInvitations Invitation[]   @relation("InvitedBy")

  createdByUser User? @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Back-relations for every domain table's createdBy/updatedBy audit FK.
  createdUsers                User[]                @relation("UserCreatedBy")
  updatedUsers                User[]                @relation("UserUpdatedBy")
  createdOrganizations        Organization[]        @relation("OrganizationCreatedBy")
  updatedOrganizations        Organization[]        @relation("OrganizationUpdatedBy")
  createdMemberships          Membership[]          @relation("MembershipCreatedBy")
  updatedMemberships          Membership[]          @relation("MembershipUpdatedBy")
  createdInvitations          Invitation[]          @relation("InvitationCreatedBy")
  updatedInvitations          Invitation[]          @relation("InvitationUpdatedBy")
  createdVendors              Vendor[]              @relation("VendorCreatedBy")
  updatedVendors              Vendor[]              @relation("VendorUpdatedBy")
  createdVendorContactPersons VendorContactPerson[] @relation("VendorContactPersonCreatedBy")
  updatedVendorContactPersons VendorContactPerson[] @relation("VendorContactPersonUpdatedBy")
  createdVendorActivities     VendorActivity[]      @relation("VendorActivityCreatedBy")
  updatedVendorActivities     VendorActivity[]      @relation("VendorActivityUpdatedBy")
  createdVendorComments       VendorComment[]       @relation("VendorCommentCreatedBy")
  updatedVendorComments       VendorComment[]       @relation("VendorCommentUpdatedBy")
  createdVendorAddresses      VendorAddress[]       @relation("VendorAddressCreatedBy")
  updatedVendorAddresses      VendorAddress[]       @relation("VendorAddressUpdatedBy")
  createdNumberSequences      NumberSequence[]      @relation("NumberSequenceCreatedBy")
  updatedNumberSequences      NumberSequence[]      @relation("NumberSequenceUpdatedBy")
  createdItems                Item[]                @relation("ItemCreatedBy")
  updatedItems                Item[]                @relation("ItemUpdatedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique // Store the hashed token if preferred, but for now we'll store the plain token as per standard or a hash. Since this is just a string, we can store it directly.
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// A user is a person who can log in — nothing more. No organizationId, no role,
// no permissions: those belong on Membership, so one person can join several
// organizations with different access in each.
//
// passwordHash is nullable because invited and SSO users exist before they set
// one, and is never selected outside the login path.

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("password_reset_tokens")
}

model Organization {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  industryCode String? @map("industry_code") @db.VarChar(64)

  dialCode String? @map("dial_code")
  phone    String?
  email    String?

  stateCode  String? @map("state_code") @db.VarChar(6)
  cityId     String? @map("city_id") @db.Uuid
  zip        String?
  orgAddress String? @map("org_address")

  taxIdValue String? @map("tax_id_value")

  isDeleted       Boolean          @default(false) @map("is_deleted")
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  industry        Industry?        @relation(fields: [industryCode], references: [code])
  state           State?           @relation(fields: [stateCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  city            City?            @relation(fields: [cityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  memberships     Membership[]
  invitations     Invitation[]
  vendors         Vendor[]
  items           Item[]
  numberSequences NumberSequence[]

  createdByUser User? @relation("OrganizationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("organizations")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String   @default("member") @db.VarChar(50) // owner, admin, member
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUser User? @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("MembershipUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// An invitation binds an *email address* (not a User) to an organization, so it
// can be sent to someone who has no account yet. It becomes a Membership only at
// accept time — see invitations.service.ts. The row holds all the real data;
// the emailed token is just a random lookup key (its SHA-256 hash is stored, so
// a leaked DB row can't be replayed — the raw token lives only in the email).
model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           String    @default("member") @db.VarChar(50) // admin | member (never owner via invite)
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("pending") @db.VarChar(20) // pending | accepted | revoked
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  createdByUser User? @relation("InvitationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("InvitationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  // One live invite per email per org — re-inviting updates the existing row.
  @@unique([organizationId, email])
  @@index([email])
  @@map("invitations")
}

model Industry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(64) // technology | manufacturing | oil_and_gas | ... — stable FK target, no spaces
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organizations Organization[]

  @@map("industries")
}

// Master data, like Industry/State/City — read-only reference rows, not tenant-scoped.
//
// `code` is ISO 3166-1 alpha-2 ("IN"); `isoCode` is alpha-3 ("IND"). They are kept
// separate because alpha-2 is what forms, phone libraries, and payment providers
// expect, while alpha-3 is what most government and shipping paperwork asks for.
// `dialCode` is the ITU calling-code prefix ("+91") the phone-number dropdown binds
// to — a phone prefix, NOT a country identifier, and deliberately NOT unique (US and
// Canada both share "+1"), which is why it is its own column, not `code`/`isoCode`.
// (Organization.dialCode stores the value the user picked from this list.)
model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  code      String   @unique @db.VarChar(2)
  isoCode   String   @unique @map("iso_code") @db.VarChar(3)
  dialCode  String   @map("dial_code") @db.VarChar(8)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  states State[]

  @@map("countries")
}

// A state's identity is its ISO 3166-2 subdivision code ("IN-GJ"), NOT a surrogate
// uuid — the code is already a stable, globally-unique standard key, so it is the
// PK and what other rows reference. `name` can be relabelled without touching a
// single referencing row. States belong to a country (countryCode -> Country.code).
model State {
  code        String   @id @db.VarChar(6)
  name        String
  countryCode String   @map("country_code") @db.VarChar(2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  country       Country        @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  cities        City[]
  organizations Organization[]

  // `name` is only unique *within* a country — two countries may both have a
  // "Georgia"-like name. Uniqueness is the (country, name) pair.
  @@unique([countryCode, name])
  @@map("states")
}

// A city has NO global standard code, so it keeps a surrogate uuid PK. `geonamesId`
// is the stable external anchor (from the GeoNames dataset) used to upsert on
// re-import so the uuid is generated once and never orphans a referencing row; it
// is nullable until a real dataset is imported. Cities link to states by code.
model City {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  geonamesId Int?     @unique @map("geonames_id")
  name       String
  stateCode  String   @map("state_code") @db.VarChar(6)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  state         State          @relation(fields: [stateCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  organizations Organization[]

  @@unique([name, stateCode])
  @@map("cities")
}

model AppModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  sortIndex Int      @default(0) @map("sort_index")
  icon      String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   AppModule?  @relation("ModuleToSubModules", fields: [parentId], references: [id], onDelete: Cascade)
  children AppModule[] @relation("ModuleToSubModules")

  @@map("app_modules")
}
