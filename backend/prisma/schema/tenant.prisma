/// The ACCOUNT: one row per person, shared by every organization they belong to.
///
/// 🔴 Everything here is GLOBAL. `firstName`/`lastName`/`fullName` are the
/// account-level name, used only where no organization is in scope — signup,
/// password-reset and invitation emails, the org picker. Inside an organization the
/// name comes from `Membership`, which may differ.
///
/// The personal details below (phone, mobile, date of birth, address, avatar) are
/// the single source of truth across all organizations, by decision on 2026-07-31.
/// A person has one date of birth; storing it per org invites contradictory copies.
/// The trade-off is real and worth remembering when touching these: an admin in one
/// organization editing them changes what every other organization sees.
model User {
  id                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                         String                  @unique @db.Citext
  passwordHash                  String?                 @map("password_hash")
  /// The `sub` from the accounts service (docs/SSO_AND_IDENTITY.md §9). Set ONCE,
  /// at first sign-in after the cutover, then never rewritten — people change
  /// emails, `sub` is forever. 🔴 `id` remains the FK target for every membership,
  /// createdBy and updatedBy in this database; repointing those at the identity id
  /// would rewrite nine schema files for no benefit.
  ///
  /// Nullable until §13 step 5: every row is null today, and the email-matching
  /// branch is what lets an existing user link on their first SSO sign-in.
  identityUserId                String?                 @unique @map("identity_user_id") @db.Uuid
  firstName                     String                  @default("") @map("first_name") @db.VarChar(40)
  lastName                      String                  @default("") @map("last_name") @db.VarChar(40)
  fullName                      String                  @default("") @map("full_name") @db.VarChar(80)
  phone                         String?                 @db.VarChar(20)
  mobile                        String?                 @db.VarChar(20)
  /// A calendar date, not an instant: `@db.Date` so a birthday never shifts by a
  /// day across timezones the way a Timestamptz would.
  dateOfBirth                   DateTime?               @map("date_of_birth") @db.Date
  addressLine1                  String?                 @map("address_line1") @db.VarChar(255)
  addressLine2                  String?                 @map("address_line2") @db.VarChar(255)
  /// Address FKs mirror `Organization` exactly — `states` is keyed by `code`
  /// (VarChar(6)), not a uuid, and `countries` by a 2-char `code`. Copying that
  /// shape is what lets the existing country/state/city pickers work unchanged.
  cityId                        String?                 @map("city_id") @db.Uuid
  stateCode                     String?                 @map("state_code") @db.VarChar(6)
  countryCode                   String?                 @map("country_code") @db.VarChar(2)
  zip                           String?                 @db.VarChar(20)
  isActive                      Boolean                 @default(true) @map("is_active")
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                     String?                 @map("created_by") @db.Uuid
  isDeleted                     Boolean                 @default(false) @map("is_deleted")
  updatedBy                     String?                 @map("updated_by") @db.Uuid
  avatarUrl                     String?                 @map("avatar_url")
  userAgent                     String?                 @map("user_agent")
  ipAddress                     String?                 @map("ip_address")
  latitude                      Float?
  longitude                     Float?
  city                          City?                   @relation(fields: [cityId], references: [id])
  country                       Country?                @relation(fields: [countryCode], references: [code])
  state                         State?                  @relation(fields: [stateCode], references: [code])
  createdCurrencies             Currency[]              @relation("CurrencyCreatedBy")
  updatedCurrencies             Currency[]              @relation("CurrencyUpdatedBy")
  createdCustomFieldDefinitions CustomFieldDefinition[] @relation("CustomFieldDefinitionCreatedBy")
  updatedCustomFieldDefinitions CustomFieldDefinition[] @relation("CustomFieldDefinitionUpdatedBy")
  createdCustomerActivities     CustomerActivity[]      @relation("CustomerActivityCreatedBy")
  updatedCustomerActivities     CustomerActivity[]      @relation("CustomerActivityUpdatedBy")
  createdCustomerAddresses      CustomerAddress[]       @relation("CustomerAddressCreatedBy")
  updatedCustomerAddresses      CustomerAddress[]       @relation("CustomerAddressUpdatedBy")
  createdCustomerComments       CustomerComment[]       @relation("CustomerCommentCreatedBy")
  updatedCustomerComments       CustomerComment[]       @relation("CustomerCommentUpdatedBy")
  createdCustomerContactPersons CustomerContactPerson[] @relation("CustomerContactPersonCreatedBy")
  updatedCustomerContactPersons CustomerContactPerson[] @relation("CustomerContactPersonUpdatedBy")
  createdCustomers              Customer[]              @relation("CustomerCreatedBy")
  updatedCustomers              Customer[]              @relation("CustomerUpdatedBy")
  createdInvitations            Invitation[]            @relation("InvitationCreatedBy")
  sentInvitations               Invitation[]            @relation("InvitedBy")
  updatedInvitations            Invitation[]            @relation("InvitationUpdatedBy")
  createdItemActivities         ItemActivity[]          @relation("ItemActivityCreatedBy")
  updatedItemActivities         ItemActivity[]          @relation("ItemActivityUpdatedBy")
  createdItems                  Item[]                  @relation("ItemCreatedBy")
  updatedItems                  Item[]                  @relation("ItemUpdatedBy")
  createdListViewPreferences    ListViewPreference[]    @relation("ListViewPreferenceCreatedBy")
  updatedListViewPreferences    ListViewPreference[]    @relation("ListViewPreferenceUpdatedBy")
  listViewPreferences           ListViewPreference[]    @relation("ListViewPreferenceUser")
  createdLocations              Location[]              @relation("LocationCreatedBy")
  updatedLocations              Location[]              @relation("LocationUpdatedBy")
  createdMemberships            Membership[]            @relation("MembershipCreatedBy")
  updatedMemberships            Membership[]            @relation("MembershipUpdatedBy")
  memberships                   Membership[]
  createdNumberSequences        NumberSequence[]        @relation("NumberSequenceCreatedBy")
  updatedNumberSequences        NumberSequence[]        @relation("NumberSequenceUpdatedBy")
  createdOrganizations          Organization[]          @relation("OrganizationCreatedBy")
  updatedOrganizations          Organization[]          @relation("OrganizationUpdatedBy")
  createdPaymentTerms           PaymentTerm[]           @relation("PaymentTermCreatedBy")
  updatedPaymentTerms           PaymentTerm[]           @relation("PaymentTermUpdatedBy")
  createdPermissionTemplates    PermissionTemplate[]    @relation("PermissionTemplateCreatedBy")
  updatedPermissionTemplates    PermissionTemplate[]    @relation("PermissionTemplateUpdatedBy")
  createdPoActivities           PurchaseOrderActivity[] @relation("PoActivityCreatedBy")
  updatedPoActivities           PurchaseOrderActivity[] @relation("PoActivityUpdatedBy")
  createdPoComments             PurchaseOrderComment[]  @relation("PoCommentCreatedBy")
  updatedPoComments             PurchaseOrderComment[]  @relation("PoCommentUpdatedBy")
  createdPurchaseOrderItems     PurchaseOrderItem[]     @relation("PoItemCreatedBy")
  updatedPurchaseOrderItems     PurchaseOrderItem[]     @relation("PoItemUpdatedBy")
  createdPurchaseOrders         PurchaseOrder[]         @relation("PoCreatedBy")
  updatedPurchaseOrders         PurchaseOrder[]         @relation("PoUpdatedBy")
  createdBills                  Bill[]                  @relation("BillCreatedBy")
  updatedBills                  Bill[]                  @relation("BillUpdatedBy")
  createdBillItems              BillItem[]              @relation("BillItemCreatedBy")
  updatedBillItems              BillItem[]              @relation("BillItemUpdatedBy")
  createdBillActivities         BillActivity[]          @relation("BillActivityCreatedBy")
  updatedBillActivities         BillActivity[]          @relation("BillActivityUpdatedBy")
  createdBillComments           BillComment[]           @relation("BillCommentCreatedBy")
  updatedBillComments           BillComment[]           @relation("BillCommentUpdatedBy")
  refreshTokens                 RefreshToken[]
  createdRoles                  Role[]                  @relation("RoleCreatedBy")
  updatedRoles                  Role[]                  @relation("RoleUpdatedBy")
  createdUnitsOfMeasurement     UnitOfMeasurement[]     @relation("UomCreatedBy")
  updatedUnitsOfMeasurement     UnitOfMeasurement[]     @relation("UomUpdatedBy")
  createdByUser                 User?                   @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers                  User[]                  @relation("UserCreatedBy")
  updatedByUser                 User?                   @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers                  User[]                  @relation("UserUpdatedBy")
  createdVendorActivities       VendorActivity[]        @relation("VendorActivityCreatedBy")
  updatedVendorActivities       VendorActivity[]        @relation("VendorActivityUpdatedBy")
  createdVendorAddresses        VendorAddress[]         @relation("VendorAddressCreatedBy")
  updatedVendorAddresses        VendorAddress[]         @relation("VendorAddressUpdatedBy")
  createdVendorComments         VendorComment[]         @relation("VendorCommentCreatedBy")
  updatedVendorComments         VendorComment[]         @relation("VendorCommentUpdatedBy")
  createdVendorContactPersons   VendorContactPerson[]   @relation("VendorContactPersonCreatedBy")
  updatedVendorContactPersons   VendorContactPerson[]   @relation("VendorContactPersonUpdatedBy")
  createdVendors                Vendor[]                @relation("VendorCreatedBy")
  updatedVendors                Vendor[]                @relation("VendorUpdatedBy")
  createdItemCategories         ItemCategory[]          @relation("CategoryCreatedBy")
  updatedItemCategories         ItemCategory[]          @relation("CategoryUpdatedBy")
  createdProcesses              Process[]               @relation("ProcessCreatedBy")
  updatedProcesses              Process[]               @relation("ProcessUpdatedBy")
  createdBatches                Batch[]                 @relation("BatchCreatedBy")
  updatedBatches                Batch[]                 @relation("BatchUpdatedBy")
  /// No `updatedStockLedgerEntries` — a ledger row is never edited. See
  /// inventory.prisma.
  createdStockLedgerEntries     StockLedgerEntry[]      @relation("StockLedgerCreatedBy")
  createdRoutes                 Route[]                 @relation("RouteCreatedBy")
  updatedRoutes                 Route[]                 @relation("RouteUpdatedBy")
  createdRouteSteps             RouteStep[]             @relation("RouteStepCreatedBy")
  updatedRouteSteps             RouteStep[]             @relation("RouteStepUpdatedBy")
  createdJobOrders              JobOrder[]              @relation("JobOrderCreatedBy")
  updatedJobOrders              JobOrder[]              @relation("JobOrderUpdatedBy")
  createdJobOrderSteps          JobOrderStep[]          @relation("JobOrderStepCreatedBy")
  updatedJobOrderSteps          JobOrderStep[]          @relation("JobOrderStepUpdatedBy")
  createdJobIssues              JobIssue[]              @relation("JobIssueCreatedBy")
  updatedJobIssues              JobIssue[]              @relation("JobIssueUpdatedBy")
  createdJobIssueLines          JobIssueLine[]          @relation("JobIssueLineCreatedBy")
  updatedJobIssueLines          JobIssueLine[]          @relation("JobIssueLineUpdatedBy")
  createdJobReceipts            JobReceipt[]            @relation("JobReceiptCreatedBy")
  updatedJobReceipts            JobReceipt[]            @relation("JobReceiptUpdatedBy")
  createdJobReceiptLines        JobReceiptLine[]        @relation("JobReceiptLineCreatedBy")
  updatedJobReceiptLines        JobReceiptLine[]        @relation("JobReceiptLineUpdatedBy")

  // Multi-item steps (domain §5.7) — the six new child tables.
  createdRouteStepInputs    RouteStepInput[]    @relation("RouteStepInputCreatedBy")
  updatedRouteStepInputs    RouteStepInput[]    @relation("RouteStepInputUpdatedBy")
  createdRouteStepOutputs   RouteStepOutput[]   @relation("RouteStepOutputCreatedBy")
  updatedRouteStepOutputs   RouteStepOutput[]   @relation("RouteStepOutputUpdatedBy")
  createdJobOrderStepInputs JobOrderStepInput[] @relation("JobOrderStepInputCreatedBy")
  updatedJobOrderStepInputs JobOrderStepInput[] @relation("JobOrderStepInputUpdatedBy")

  createdJobOrderStepInputBatches JobOrderStepInputBatch[] @relation("JobOrderStepInputBatchCreatedBy")
  updatedJobOrderStepInputBatches JobOrderStepInputBatch[] @relation("JobOrderStepInputBatchUpdatedBy")
  createdJobOrderStepOutputs      JobOrderStepOutput[]     @relation("JobOrderStepOutputCreatedBy")
  updatedJobOrderStepOutputs      JobOrderStepOutput[]     @relation("JobOrderStepOutputUpdatedBy")
  createdJobReceiptOutputs        JobReceiptOutput[]       @relation("JobReceiptOutputCreatedBy")
  updatedJobReceiptOutputs        JobReceiptOutput[]       @relation("JobReceiptOutputUpdatedBy")
  createdJobReceiptOutputBatches  JobReceiptOutputBatch[]  @relation("JobReceiptOutputBatchCreatedBy")
  updatedJobReceiptOutputBatches  JobReceiptOutputBatch[]  @relation("JobReceiptOutputBatchUpdatedBy")
  createdRejectionReasons         RejectionReason[]        @relation("RejectionReasonCreatedBy")
  updatedRejectionReasons         RejectionReason[]        @relation("RejectionReasonUpdatedBy")
  createdCompositeComponents      CompositeItemComponent[] @relation("CompositeComponentCreatedBy")
  updatedCompositeComponents      CompositeItemComponent[] @relation("CompositeComponentUpdatedBy")
  createdItemAssemblies           ItemAssembly[]           @relation("ItemAssemblyCreatedBy")
  updatedItemAssemblies           ItemAssembly[]           @relation("ItemAssemblyUpdatedBy")
  createdItemAssemblyLines        ItemAssemblyLine[]       @relation("ItemAssemblyLineCreatedBy")
  updatedItemAssemblyLines        ItemAssemblyLine[]       @relation("ItemAssemblyLineUpdatedBy")
  createdItemAssemblyComments     ItemAssemblyComment[]    @relation("ItemAssemblyCommentCreatedBy")
  updatedItemAssemblyComments     ItemAssemblyComment[]    @relation("ItemAssemblyCommentUpdatedBy")
  createdItemAssemblyActivities   ItemAssemblyActivity[]   @relation("ItemAssemblyActivityCreatedBy")
  updatedItemAssemblyActivities   ItemAssemblyActivity[]   @relation("ItemAssemblyActivityUpdatedBy")
  createdItemOpeningStockRows     ItemOpeningStockRow[]    @relation("ItemOpeningStockRowCreatedBy")
  updatedItemOpeningStockRows     ItemOpeningStockRow[]    @relation("ItemOpeningStockRowUpdatedBy")

  @@map("users")
}

/// One row per device session, from login to the moment it ends.
///
/// 🔴 The token is NOT rotated (changed 2026-07-31). A session's `token` is
/// written once at login and never replaced, which is what makes this row a
/// stable record: `created_at` is the real login time for the whole life of the
/// session, and `id` — the access token's `sid` — never moves.
///
/// Rotation was removed because it cannot be made safe across a network: the
/// server committed the new token before the browser had received it, so any
/// interrupted refresh (reload, dropped wifi, closed lid) left the browser
/// holding a token the server had already destroyed. That was read as theft and
/// revoked every session the user had. See docs/AUTHENTICATION.md §4.4.
///
/// 🔴 Rows are NEVER deleted — ending a session stamps `revoked_at`. That is what
/// makes login reporting possible, and it means every read must filter
/// `revokedAt: null`, exactly like `isDeleted: false` elsewhere. A hard delete of
/// the user still cascades, which is how test fixtures clean up.
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Last time this session was exchanged for an access token. With `createdAt`
  /// it gives session length; null means the user never came back after login.
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// Null = live. Set = ended, and the row stays for reporting.
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// logout | expired | password_reset | account_disabled | superseded | sso_logout
  ///
  /// `sso_logout` is written by the back-channel logout endpoint (§10.2) — the IdP
  /// told us this session ended elsewhere. Distinct from `logout`, which is this
  /// app's own, so the login report can tell "signed out here" from "signed out
  /// centrally".
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  /// `sid` from the ID token — which SSO session created this app session.
  /// 🔴 NOT the same thing as the `sid` claim in our own access token, which is
  /// this row's `id`. Two different ids, one word; conflating them in the revoke
  /// path fails open. Never rename this column `sid`.
  ///
  /// 🔴 VarChar, not Uuid — corrected 2026-08-24. §9.1 specified `@db.Uuid`, but
  /// the IdP's sid is `nanoid()`: 43 characters of a URL-safe alphabet. Postgres
  /// rejects one with `invalid input syntax for type uuid`, so the original type
  /// would have failed on the first SSO login rather than at review. It is also
  /// per-client — our sid differs from the one any other app receives for the same
  /// browser session, which is deliberate in OIDC so two apps cannot correlate a
  /// user.
  idpSessionId  String?   @map("idp_session_id") @db.VarChar(64)
  /// `sub` — for "disable this account everywhere", which has no single sid.
  idpSubject    String?   @map("idp_subject") @db.Uuid
  /// Captured at login so a report can say WHICH device, rather than showing the
  /// user's single most recent agent — `users.user_agent` is overwritten on every
  /// login and cannot answer that.
  ///
  /// No IP address alongside it, deliberately: behind Catalyst's load balancer
  /// `req.ip` is the balancer, not the client, unless `trust proxy` is configured
  /// — so the column would hold one constant — and an IP is personal data in a
  /// table that never deletes rows.
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  latitude      Float?
  longitude     Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The live-session lookup on every refresh, and the per-user session history
  /// a report reads.
  @@index([userId, revokedAt])
  /// Back-channel logout arrives naming a `sid`, and "disable everywhere" names a
  /// `sub` — both have to find every affected session without scanning the table.
  @@index([idpSessionId])
  @@index([idpSubject])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("password_reset_tokens")
}

model Organization {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable support code shown under the org name in the switcher, so a
  /// customer can read it to support without spelling out a uuid. Ten random
  /// digits — NOT an identifier: never in a URL, never an FK, never a credential.
  /// Random rather than a sequence so codes don't leak tenant count or signup
  /// order. Stored as text, not bigint, because Prisma maps bigint to JS BigInt
  /// and JSON.stringify throws on it, which would break every sendSuccess payload.
  /// No DB default on purpose — the app supplies it, so a missing value is a loud
  /// NOT NULL error rather than a silently auto-filled one.
  orgCode                String                  @unique @map("org_code") @db.VarChar(10)
  name                   String
  phone                  String?
  email                  String?
  zip                    String?
  dialCode               String?                 @map("dial_code")
  orgAddress             String?                 @map("org_address")
  website                String?                 @map("website")
  taxIdValue             String?                 @map("tax_id_value")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  industryCode           String?                 @map("industry_code") @db.VarChar(64)
  createdBy              String?                 @map("created_by") @db.Uuid
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  updatedBy              String?                 @map("updated_by") @db.Uuid
  stateCode              String?                 @map("state_code") @db.VarChar(6)
  cityId                 String?                 @map("city_id") @db.Uuid
  countryCode            String?                 @map("country_code") @db.VarChar(2)
  logoUrl                String?                 @map("logo_url")
  currencies             Currency[]
  customFieldDefinitions CustomFieldDefinition[]
  customers              Customer[]
  invitations            Invitation[]
  items                  Item[]
  listViewPreferences    ListViewPreference[]
  locations              Location[]
  memberships            Membership[]
  numberSequences        NumberSequence[]
  city                   City?                   @relation(fields: [cityId], references: [id])
  country                Country?                @relation(fields: [countryCode], references: [code])
  createdByUser          User?                   @relation("OrganizationCreatedBy", fields: [createdBy], references: [id])
  industry               Industry?               @relation(fields: [industryCode], references: [code])
  state                  State?                  @relation(fields: [stateCode], references: [code])
  updatedByUser          User?                   @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id])
  paymentTerms           PaymentTerm[]
  permissionTemplates    PermissionTemplate[]
  purchaseOrders         PurchaseOrder[]
  bills                  Bill[]
  roles                  Role[]
  unitsOfMeasurement     UnitOfMeasurement[]
  vendors                Vendor[]
  itemCategories         ItemCategory[]
  processes              Process[]
  batches                Batch[]
  stockLedgerEntries     StockLedgerEntry[]
  routes                 Route[]
  routeSteps             RouteStep[]
  jobOrders              JobOrder[]
  jobOrderSteps          JobOrderStep[]
  jobIssues              JobIssue[]
  jobIssueLines          JobIssueLine[]
  jobReceipts            JobReceipt[]
  jobReceiptLines        JobReceiptLine[]
  rejectionReasons       RejectionReason[]

  // Multi-item steps (domain §5.7). Every one of these carries its own
  // `organization_id` so it can hold its own RLS policy, exactly like
  // `job_issue_lines` — a child table that has to join its parent to be filtered
  // is a table whose policy is one forgotten join away from leaking.
  routeStepInputs          RouteStepInput[]
  routeStepOutputs         RouteStepOutput[]
  jobOrderStepInputs       JobOrderStepInput[]
  jobOrderStepInputBatches JobOrderStepInputBatch[]
  jobOrderStepOutputs      JobOrderStepOutput[]
  jobReceiptOutputs        JobReceiptOutput[]
  jobReceiptOutputBatches  JobReceiptOutputBatch[]
  compositeItemComponents  CompositeItemComponent[]
  itemAssemblies           ItemAssembly[]
  itemAssemblyLines        ItemAssemblyLine[]
  itemAssemblyComments     ItemAssemblyComment[]
  itemAssemblyActivities   ItemAssemblyActivity[]
  itemOpeningStockRows     ItemOpeningStockRow[]
  settings                 Json                    @default("{}") @map("settings")
  @@map("organizations")
}

/// A person's membership of one organization.
///
/// 🔴 THE NAME IS PER-ORG. EVERY OTHER PERSONAL DETAIL IS NOT.
///
/// The name shown anywhere inside an organization comes from THIS row, never from
/// `User`: the same account can be "James Walker" in one org and "J. Walker" in
/// another, and editing one must never write the other.
///
/// Everything else about the person — phone, mobile, date of birth, address,
/// avatar — lives on `User` and is deliberately SHARED by every organization they
/// belong to (2026-07-31). One person has one phone number; duplicating it per org
/// invites two orgs holding contradictory values with no way to say which is
/// current. The cost is that an admin in one org editing those fields changes what
/// every other org sees, which is what "single source of truth" means here.
///
/// So the rule for anything you are tempted to add to this table: does the ANSWER
/// legitimately differ per organization? Job title, access, active state and the
/// display name do. A date of birth does not.
///
/// `fullName` is denormalized from `firstName`/`lastName` — the same trade `User`
/// already makes — so list queries and the createdBy/updatedBy directory read one
/// column instead of concatenating. It is written in the service layer only
/// (`composeFullName`); never let a caller set it directly or the two drift.
model Membership {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  firstName            String              @map("first_name") @db.VarChar(40)
  lastName             String              @map("last_name") @db.VarChar(40)
  /// Derived from firstName + lastName in the service. Never client-supplied.
  fullName             String              @map("full_name") @db.VarChar(81)
  /// Deactivated in THIS organization while keeping the row, its history, and its
  /// createdBy/updatedBy attribution. 🔴 `tenantContext` filters on it, so an
  /// inactive member is denied every tenant route on their next request — this is
  /// not a display flag. Distinct from `isDeleted` (removed from the org) and from
  /// `User.isActive` (the account itself, across all orgs).
  isActive             Boolean             @default(true) @map("is_active")
  /// Per-org dynamic fields, same as every other domain table. Definitions live
  /// once in `custom_field_definitions` with `entityType: 'member'`; their
  /// `display_order` (set by dragging rows in Settings → Modules → Users) decides
  /// where each `cf:` column appears in the Users list.
  customFields         Json                @default("{}") @map("custom_fields")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?             @map("created_by") @db.Uuid
  isDeleted            Boolean             @default(false) @map("is_deleted")
  updatedBy            String?             @map("updated_by") @db.Uuid
  permissionTemplateId String?             @map("permission_template_id") @db.Uuid
  roleId               String?             @map("role_id") @db.Uuid
  isOwner              Boolean             @default(false) @map("is_owner")
  createdByUser        User?               @relation("MembershipCreatedBy", fields: [createdBy], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissionTemplate   PermissionTemplate? @relation(fields: [permissionTemplateId], references: [id])
  role                 Role?               @relation(fields: [roleId], references: [id])
  updatedByUser        User?               @relation("MembershipUpdatedBy", fields: [updatedBy], references: [id])
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  /// Drives the createdBy/updatedBy name directory: one probe per (org, user).
  @@index([organizationId, isDeleted])
  @@map("memberships")
}

model Invitation {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  email                String             @db.Citext
  /// The name the inviter entered. Required by `createInvitationSchema`, so every
  /// invite created from 2026-07-30 on carries one — that is what makes a pending
  /// row render as a person in the Users list instead of a bare email address.
  ///
  /// Nullable in the DATABASE on purpose: invitations created before this change
  /// have no name, and inventing one from the email local-part would be fabricated
  /// data sitting in a customer's org forever. `acceptInvitation` falls back to the
  /// account name for those rows. Do not "tighten" this to NOT NULL without first
  /// deciding what the legacy rows should say.
  firstName            String?            @map("first_name") @db.VarChar(40)
  lastName             String?            @map("last_name") @db.VarChar(40)
  tokenHash            String             @unique @map("token_hash")
  status               String             @default("pending") @db.VarChar(20)
  invitedById          String             @map("invited_by_id") @db.Uuid
  expiresAt            DateTime           @map("expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime?          @map("accepted_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?            @map("created_by") @db.Uuid
  isDeleted            Boolean            @default(false) @map("is_deleted")
  updatedBy            String?            @map("updated_by") @db.Uuid
  declinedAt           DateTime?          @map("declined_at") @db.Timestamptz(6)
  lastSentAt           DateTime?          @map("last_sent_at") @db.Timestamptz(6)
  permissionTemplateId String             @map("permission_template_id") @db.Uuid
  sendCount            Int                @default(0) @map("send_count")
  roleId               String?            @map("role_id") @db.Uuid
  createdByUser        User?              @relation("InvitationCreatedBy", fields: [createdBy], references: [id])
  invitedBy            User               @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissionTemplate   PermissionTemplate @relation(fields: [permissionTemplateId], references: [id])
  role                 Role?              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  updatedByUser        User?              @relation("InvitationUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId, lastSentAt])
  @@index([email])
  @@map("invitations")
}

