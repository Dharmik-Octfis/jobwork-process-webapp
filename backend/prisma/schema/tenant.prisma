// Tenant domain: Organization, User, Membership, Invitation (architecture §4).
// Only User exists so far. See docs/PRISMA.md §4.3 for why each attribute is here.

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String?  @map("password_hash")
  firstName    String   @default("") @map("first_name") @db.VarChar(40)
  lastName     String   @default("") @map("last_name") @db.VarChar(40)
  fullName     String   @default("") @map("full_name") @db.VarChar(80)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  memberships   Membership[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique // Store the hashed token if preferred, but for now we'll store the plain token as per standard or a hash. Since this is just a string, we can store it directly.
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// A user is a person who can log in — nothing more. No organizationId, no role,
// no permissions: those belong on Membership, so one person can join several
// organizations with different access in each.
//
// passwordHash is nullable because invited and SSO users exist before they set
// one, and is never selected outside the login path.

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("password_reset_tokens")
}

model Organization {
  id           String  @id @map("organization_id")
  name         String
  industryType String? @map("industry_type")

  phone String?
  email String?

  city       String?
  state      String?
  zip        String?
  orgAddress String? @map("org_address")

  taxIdValue String? @map("tax_id_value")

  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id")
  role           String   @default("member") @db.VarChar(50) // owner, admin, member
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Industry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("industries")
}

model State {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cities City[]

  @@map("states")
}

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  stateId   String   @map("state_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([name, stateId])
  @@map("cities")
}
