// ============================================================================
// Approval Processes & Workflow Automation Schema
// Matches PostgreSQL migration: 20260918110000_create_approval_process_tables
// ============================================================================

model ApprovalProcess {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  description    String?  @db.Text
  moduleId       String   @map("module_id") @db.VarChar(100)
  triggerType    String   @default("CREATE_OR_EDIT") @map("trigger_type") @db.VarChar(50)
  status         String   @default("DRAFT") @db.VarChar(30)
  priority       Int      @default(0)
  currentVersion Int      @default(1) @map("current_version")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?                    @relation("ApprovalProcessCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  updatedByUser User?                    @relation("ApprovalProcessUpdatedBy", fields: [updatedBy], references: [id], onUpdate: NoAction)
  rules         ApprovalProcessRule[]
  versions      ApprovalProcessVersion[]
  admins        ApprovalProcessAdmin[]
  requests      ApprovalRequest[]

  @@index([organizationId, moduleId, status, isDeleted], map: "idx_approval_processes_org_module")
  @@index([organizationId, moduleId, priority], map: "idx_approval_processes_priority")
  @@map("approval_processes")
}

model ApprovalProcessVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processId      String   @map("process_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  snapshot       Json     @db.JsonB
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  process       ApprovalProcess   @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?             @relation("ApprovalProcessVersionCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  requests      ApprovalRequest[]

  @@index([processId, versionNumber], map: "idx_approval_process_versions_proc")
  @@map("approval_process_versions")
}

model ApprovalProcessRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  processId       String   @map("process_id") @db.Uuid
  name            String   @default("Rule 1") @db.VarChar(150)
  ruleOrder       Int      @default(1) @map("rule_order")
  criteria        Json     @default("[]") @db.JsonB
  criteriaPattern String   @default("1") @map("criteria_pattern") @db.VarChar(255)
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  process       ApprovalProcess   @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?             @relation("ApprovalProcessRuleCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  updatedByUser User?             @relation("ApprovalProcessRuleUpdatedBy", fields: [updatedBy], references: [id], onUpdate: NoAction)
  stages        ApprovalStage[]
  actions       ApprovalAction[]
  requests      ApprovalRequest[]

  @@index([processId, ruleOrder, isDeleted], map: "idx_approval_process_rules_proc")
  @@map("approval_process_rules")
}

model ApprovalStage {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  ruleId                   String   @map("rule_id") @db.Uuid
  name                     String   @default("Stage 1") @db.VarChar(150)
  stageOrder               Int      @default(1) @map("stage_order")
  approverType             String   @default("USER") @map("approver_type") @db.VarChar(50)
  approverConfig           Json     @default("{}") @map("approver_config") @db.JsonB
  approvalMode             String   @default("ANYONE") @map("approval_mode") @db.VarChar(50)
  assignTaskForApprovers   Boolean  @default(false) @map("assign_task_for_approvers")
  recordModificationConfig Json     @default("{}") @map("record_modification_config") @db.JsonB
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdBy                String?  @map("created_by") @db.Uuid
  updatedBy                String?  @map("updated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rule            ApprovalProcessRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser   User?                  @relation("ApprovalStageCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  updatedByUser   User?                  @relation("ApprovalStageUpdatedBy", fields: [updatedBy], references: [id], onUpdate: NoAction)
  actions         ApprovalAction[]
  requestStages   ApprovalRequestStage[]
  currentRequests ApprovalRequest[]

  @@index([ruleId, stageOrder, isDeleted], map: "idx_approval_stages_rule")
  @@map("approval_stages")
}

model ApprovalAction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  stageId        String?  @map("stage_id") @db.Uuid
  triggerEvent   String   @default("FINAL_APPROVAL") @map("trigger_event") @db.VarChar(50)
  actionType     String   @map("action_type") @db.VarChar(50)
  actionConfig   Json     @default("{}") @map("action_config") @db.JsonB
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rule          ApprovalProcessRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stage         ApprovalStage?            @relation(fields: [stageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser User?                     @relation("ApprovalActionCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction)
  updatedByUser User?                     @relation("ApprovalActionUpdatedBy", fields: [updatedBy], references: [id], onUpdate: NoAction)
  executions    ApprovalActionExecution[]

  @@index([ruleId, triggerEvent, isDeleted], map: "idx_approval_actions_rule")
  @@map("approval_actions")
}

model ApprovalProcessAdmin {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processId      String   @map("process_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  canOverride    Boolean  @default(true) @map("can_override")
  canReassign    Boolean  @default(true) @map("can_reassign")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  process      ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([processId, userId], map: "uq_approval_process_admin")
  @@map("approval_process_admins")
}

model ApprovalRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  processId        String    @map("process_id") @db.Uuid
  processVersionId String?   @map("process_version_id") @db.Uuid
  ruleId           String?   @map("rule_id") @db.Uuid
  moduleId         String    @map("module_id") @db.VarChar(100)
  // varchar, not uuid — the engine's raw SQL compares it as text, without a ::uuid cast
  recordId         String    @map("record_id") @db.VarChar(100)
  recordTitle      String    @map("record_title") @db.VarChar(255)
  recordSnapshot   Json      @default("{}") @map("record_snapshot") @db.JsonB
  status           String    @default("PENDING") @db.VarChar(50)
  currentStageId   String?   @map("current_stage_id") @db.Uuid
  requesterId      String?   @map("requester_id") @db.Uuid
  submittedAt      DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  process          ApprovalProcess           @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processVersion   ApprovalProcessVersion?   @relation(fields: [processVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  rule             ApprovalProcessRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentStage     ApprovalStage?            @relation(fields: [currentStageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  requester        User?                     @relation("ApprovalRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdByUser    User?                     @relation("ApprovalRequestCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedByUser    User?                     @relation("ApprovalRequestUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stages           ApprovalRequestStage[]
  history          ApprovalHistory[]
  actionExecutions ApprovalActionExecution[]
  notifications    ApprovalNotification[]

  @@index([organizationId, moduleId, recordId, status], map: "idx_approval_requests_record")
  @@index([requesterId, status], map: "idx_approval_requests_requester")
  @@index([processId, status], map: "idx_approval_requests_process")
  @@map("approval_requests")
}

model ApprovalRequestStage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  stageId        String?   @map("stage_id") @db.Uuid
  stageOrder     Int       @default(1) @map("stage_order")
  name           String    @db.VarChar(150)
  status         String    @default("PENDING") @db.VarChar(50)
  approvalMode   String    @default("ANYONE") @map("approval_mode") @db.VarChar(50)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request      ApprovalRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stage        ApprovalStage?            @relation(fields: [stageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approvers    ApprovalRequestApprover[]

  @@index([requestId, stageOrder], map: "idx_approval_request_stages_req")
  @@map("approval_request_stages")
}

model ApprovalRequestApprover {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestStageId String    @map("request_stage_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  status         String    @default("PENDING") @db.VarChar(50)
  actionTakenAt  DateTime? @map("action_taken_at") @db.Timestamptz(6)
  comment        String?   @db.Text
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(255)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestStage ApprovalRequestStage @relation(fields: [requestStageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, status], map: "idx_approval_request_approvers_user")
  @@index([requestStageId], map: "idx_approval_request_approvers_stage")
  @@map("approval_request_approvers")
}

model ApprovalHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(80)
  actorId        String?  @map("actor_id") @db.Uuid
  previousStatus String?  @map("previous_status") @db.VarChar(50)
  newStatus      String?  @map("new_status") @db.VarChar(50)
  comment        String?  @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([requestId, createdAt], map: "idx_approval_history_req")
  @@map("approval_history")
}

model ApprovalActionExecution {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  requestId        String    @map("request_id") @db.Uuid
  actionId         String?   @map("action_id") @db.Uuid
  actionType       String    @map("action_type") @db.VarChar(50)
  triggerEvent     String    @map("trigger_event") @db.VarChar(50)
  status           String    @default("SUCCESS") @db.VarChar(50)
  attempts         Int       @default(1)
  errorMessage     String?   @map("error_message") @db.Text
  payloadSent      Json?     @map("payload_sent") @db.JsonB
  responseReceived Json?     @map("response_received") @db.JsonB
  executedAt       DateTime  @default(now()) @map("executed_at") @db.Timestamptz(6)
  nextRetryAt      DateTime? @map("next_retry_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  action       ApprovalAction? @relation(fields: [actionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([requestId, status], map: "idx_approval_action_executions_req")
  @@map("approval_action_executions")
}

model ApprovalNotification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  title          String   @db.VarChar(255)
  message        String   @db.Text
  type           String   @default("APPROVAL_REQUIRED") @db.VarChar(50)
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipient    User            @relation("ApprovalNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipientId, isRead], map: "idx_approval_notifications_recip")
  @@map("approval_notifications")
}
