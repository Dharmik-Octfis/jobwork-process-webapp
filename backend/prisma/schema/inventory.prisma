/// Inventory core — the spine everything else attaches to.
///
/// 🔴 NOTHING WRITES `stock_ledger` EXCEPT `stockLedger.service.ts`. Not a seed,
/// not a script, not a "quick fix". A wrong number can be recomputed; a wrong
/// history cannot. Same class of rule as "`authenticate` never touches the
/// database". `batches` has a read-only list module on top of it
/// (`modules/inventory/batches/`); the ledger has none by design.
///
/// Two decisions are baked in here and are expensive to reverse (plan §3):
///   1. Batch value is DERIVED from the ledger, never stored on the batch. That is
///      why there is no `value` column below — `valueIn`/`valueOut` on the ledger
///      make value the same SUM shape as quantity.
///   2. Valuation is SPECIFIC-BATCH, implied by batch tracking being mandatory
///      internally.
///
/// 🔴 A BATCH IS ALWAYS CREATED, whatever `Item.batchTracking` says. That column
/// controls only how much of it the USER sees; the ledger always has exactly one
/// batch to hang a quantity on. Package-level (per-taka) tracking was removed on
/// 2026-08-12 — quantity granularity stops at the batch.

/// A traceable quantity of one item. Every ledger row references exactly one.
///
/// 🔴 `ownership` and `parentBatchIds` exist from the FIRST migration even though
/// nothing reads them until Sprints 2–4 (domain doc §11.3). Retrofitting ownership
/// means revisiting every valuation query ever written; genealogy cannot be
/// reconstructed from history that was never recorded.
model Batch {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// One global sequence per org (`number_sequences`, entityType `batch`). Manual
  /// entry is allowed — mills carry the supplier's number on a physical tag.
  ///
  /// 🔴 The number carries NO meaning. A child batch has a higher number than its
  /// parents only because it was created later. Parentage lives ONLY in
  /// `parentBatchIds` (§5.2.2).
  batchNumber String @map("batch_number") @db.VarChar(50)

  /// The vendor's OWN batch number, or whatever the physical tag says. Steel's
  /// heat number lands here too. Searchable, NOT unique — two deliveries of the
  /// same supplier batch, and two suppliers who both number from 1, are both
  /// normal. This is what stops anyone binding the batch number to a PO (§5.2.2).
  supplierBatchRef String? @map("supplier_batch_ref") @db.VarChar(100)

  itemId String  @map("item_id") @db.Uuid
  /// Snapshot of the item's stocking uom at creation. A balance is always one
  /// number in one unit (§5.1), so the unit belongs on the batch, not on each row.
  uomId  String? @map("uom_id") @db.Uuid

  /// own | customer — §5.3. `own` enters valuation and COGS; `customer` is always
  /// zero-valued and its exit is a SERVICE sale, not a goods sale. Every valuation
  /// query filters on this; no quantity query does.
  ownership String @default("own") @db.VarChar(20)

  /// The customer whose goods these are, when `ownership = 'customer'`. This one
  /// pair is what makes inward jobwork (shape D) nearly free.
  ///
  /// A PLAIN uuid with no foreign key and no back-relation on `Customer`,
  /// deliberately (2026-08-05). Three reasons:
  ///
  ///   1. The FK was doing less than it looked like. Postgres checks foreign keys
  ///      OUTSIDE row-level security, so it accepted a customer id from any
  ///      organization — it only rejected an id that existed nowhere at all. The
  ///      check that actually matters, "is this a customer in THIS org", has to
  ///      live in the service either way.
  ///   2. `stock_ledger.owner_party_id` never had one. The same value being
  ///      constrained on one table and not the other is the kind of asymmetry
  ///      nobody remembers the reason for six months later.
  ///   3. Prisma has no one-sided relations, so keeping the FK meant carrying an
  ///      `ownedBatches` collection on `Customer` that nothing ever navigated. A
  ///      customer's batches are a query — `WHERE owner_party_id = :id` — and every
  ///      real use of them (valuation, the return challan, traceability) filters
  ///      by more than the customer anyway.
  ///
  /// 🔴 The COLUMN is still load-bearing and must not be dropped. It is half of
  /// the ownership pair that decides whether stock is our asset or someone
  /// else's, and retrofitting it means revisiting every valuation query ever
  /// written (domain doc §11.3). Only the constraint went.
  ownerPartyId String? @map("owner_party_id") @db.Uuid

  /// Genealogy. Zero, one, or MANY parents — grey from two POs dyed together comes
  /// back as one batch. A plain uuid array rather than a join table: it is read
  /// whole and never joined against.
  ///
  /// ⚠️ APPEND-ONLY SINCE 2026-08-21, where it used to be write-once. A receipt may
  /// now add quantity to a batch an earlier receipt created (the second half of a
  /// split delivery), and that second delivery can have consumed different input
  /// batches. The alternative was a genealogy that silently omits them, and an
  /// incomplete trace is worse than a mutable one — this array is the ONLY record
  /// of where a batch came from (§11.3). Parents are appended, deduped, and never
  /// removed; a batch is never its own parent.
  ///
  /// 🔴 This is what makes the output of a jobwork step traceable at all. The
  /// processor returns a physically NEW thing with no number of its own, so the
  /// link back to what it was made from exists only because it is written here at
  /// receipt time.
  parentBatchIds String[] @default([]) @map("parent_batch_ids") @db.Uuid

  /// What brought this batch into existence: job_order_material_in (Sprint 2),
  /// job_receipt (Sprint 4), item_opening_stock, and later purchase_receipt /
  /// sales_return.
  sourceDocType String? @map("source_doc_type") @db.VarChar(40)
  sourceDocId   String? @map("source_doc_id") @db.Uuid

  /// open | consumed | closed
  state String @default("open") @db.VarChar(20)

  /// 🔴 REAL COLUMNS, not `custom_fields`. Until 2026-08-13 all five lived in the
  /// JSONB bag, which meant no type check, no constraint, and — the one that
  /// actually bites — no index. "Which batches expire in 30 days" is the entire
  /// reason a factory records an expiry date, and against JSONB that is a full
  /// scan of every batch with the date stored as an untyped string.
  ///
  /// `custom_fields` stays for what it is for: PER-ORG dynamic fields. These five
  /// are a fixed set every org gets (CLAUDE.md's rule).
  ///
  /// The maker's own batch number, which is NOT the supplier's — a trader passes
  /// on goods whose manufacturer marked them differently from the trader's own
  /// docket. `supplierBatchRef` above is who we bought from; this is who made it.
  manufacturerBatch String?   @map("manufacturer_batch") @db.VarChar(100)
  manufacturedDate  DateTime? @map("manufactured_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date

  /// Batch-wise pricing. Nullable because most batches never carry either — the
  /// item's own price applies, and a zero here would read as "free" rather than
  /// "not stated".
  mrp          Decimal? @db.Decimal(18, 4)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(18, 4)

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item          Item               @relation(fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("BatchUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("BatchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("BatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  ledgerEntries StockLedgerEntry[]

  issueLines JobIssueLine[] @relation("JobIssueLineBatch")

  /// Job orders that PLAN to use this batch. A note, not a hold — see the model.
  plannedForStepInputs JobOrderStepInputBatch[] @relation("JobOrderStepInputBatchBatch")
  receiptsAsOutput     JobReceipt[]             @relation("JobReceiptOutputBatch")
  receiptsAsRework     JobReceipt[]             @relation("JobReceiptReworkBatch")

  /// Multi-item receipts (domain §5.7): one output ROW per returned item, each
  /// creating its own batch. The two above are the single-output header columns.
  receiptOutputRows       JobReceiptOutput[] @relation("JobReceiptOutputRowBatch")
  receiptOutputReworkRows JobReceiptOutput[] @relation("JobReceiptOutputRowReworkBatch")

  /// Every allocation that put quantity INTO this batch. More than one row here
  /// means the batch was continued across deliveries rather than cloned.
  receiptOutputBatchRows  JobReceiptOutputBatch[] @relation("JobReceiptOutputBatchBatch")

  assembliesAsComposite ItemAssembly[]     @relation("ItemAssemblyCompositeBatch")
  assemblyLines         ItemAssemblyLine[] @relation("ItemAssemblyLineBatch")

  @@unique([organizationId, batchNumber])
  @@index([organizationId, itemId])
  /// The expiry report's index — the whole point of promoting the column out of
  /// JSONB. Partial: a batch with no expiry date is never an answer to "what
  /// expires soon", and most batches have none.
  @@index([organizationId, expiryDate])
  /// 🔴 TRIGRAM, because every batch search here is an infix `ILIKE '%term%'` and
  /// no b-tree can serve one — the two columns people actually type are what is
  /// printed on the physical tag, and they type the middle of it. Added
  /// 2026-08-22 with the Receive picker: that query used to run only once
  /// somebody had typed, and now runs on every plain open of the dropdown, per
  /// returned row. A sequential scan is invisible at a few hundred batches and
  /// is the whole response time at a hundred thousand.
  @@index([supplierBatchRef(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([manufacturerBatch(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("batches")
}

/// 🔴 EVERY MOVEMENT OF EVERY QUANTITY. Append-only.
///
/// There is no `stock_balance` table and there will not be one. Availability is
/// `SUM(qty_in − qty_out)` grouped by item × batch × location × ownership (§5.6). A
/// corrected mistake is a REVERSING ENTRY, never an edit and never a delete;
/// cancelling a posted document posts the opposite rows and flips the document's
/// status. History survives and the balance is still right.
///
/// This is why the table takes `created_by` / `created_at` but NOT `is_deleted` or
/// `updated_by`, and no `custom_fields`: a ledger row is not a domain entity with a
/// form behind it, it is a fact that happened. Same reasoning that made
/// `refresh_tokens` a retained log (CLAUDE.md's exclusion list).
model StockLedgerEntry {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  itemId  String @map("item_id") @db.Uuid
  batchId String @map("batch_id") @db.Uuid

  /// WHERE the stock is. Goods at a processor are OUR stock at THEIR location
  /// (§5.4) — one axis, not a location plus a separate "with-processor" state, so
  /// a godown-to-godown transfer and a send-to-processor are the same operation.
  locationId String @map("location_id") @db.Uuid

  /// Copied from the batch at post time, deliberately. A ledger row is a historical
  /// fact; re-deriving ownership through a join would let a later edit to the batch
  /// silently rewrite what a past valuation said.
  ownership    String  @default("own") @db.VarChar(20)
  ownerPartyId String? @map("owner_party_id") @db.Uuid

  uomId String? @map("uom_id") @db.Uuid

  /// One direction per row, the other zero — never a signed quantity. Two columns
  /// make "how much came in" and "how much went out" separate SUMs rather than two
  /// filtered ones, and a sign error becomes impossible to write.
  qtyIn  Decimal @default(0) @map("qty_in") @db.Decimal(18, 4)
  qtyOut Decimal @default(0) @map("qty_out") @db.Decimal(18, 4)

  /// Value moves with quantity, which is what makes batch value derived rather than
  /// stored (plan §3, decision 1). Customer-owned stock always posts ZERO value.
  valueIn  Decimal @default(0) @map("value_in") @db.Decimal(18, 4)
  valueOut Decimal @default(0) @map("value_out") @db.Decimal(18, 4)

  /// What kind of movement this is, for reporting and for reversal pairing:
  /// opening | receipt | issue | transfer_in | transfer_out | consume | produce |
  /// scrap | adjustment | reversal
  movementType String @map("movement_type") @db.VarChar(30)

  /// both | physical | accounting
  stockEffect String @default("both") @map("stock_effect") @db.VarChar(20)

  /// The document that caused it. Not an FK — the referenced table differs per
  /// `sourceDocType` (job_issue, job_receipt, job_order, …) and several of those
  /// tables do not exist yet.
  sourceDocType   String  @map("source_doc_type") @db.VarChar(40)
  sourceDocId     String? @map("source_doc_id") @db.Uuid
  sourceDocLineId String? @map("source_doc_line_id") @db.Uuid

  /// Free-text why, for adjustments and reversals.
  remarks String?

  /// When the movement HAPPENED, which is not always when the row was written —
  /// a challan dated yesterday entered this morning must age from yesterday. GST
  /// requires jobwork goods back within 180/365 days, so the ageing report reads
  /// this column, never `created_at`.
  postedAt DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item          Item               @relation(fields: [itemId], references: [id])
  batch         Batch              @relation(fields: [batchId], references: [id])
  location      Location           @relation("StockLedgerLocation", fields: [locationId], references: [id])
  uom           UnitOfMeasurement? @relation("StockLedgerUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("StockLedgerCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  /// The balance query's index, per §5.6. A materialised balance view comes only
  /// when a real query proves it necessary — do not pre-optimise a correctness
  /// guarantee away.
  @@index([organizationId, itemId, batchId, locationId])
  @@index([organizationId, locationId, postedAt])
  /// "Which rows did this document write?" — the consumed-per-receipt read, and
  /// every reversal and drill-down after it. Neither index above starts with a
  /// column those queries constrain, so they fall back to scanning the org's
  /// whole ledger, which is the fastest-growing table here.
  @@index([organizationId, sourceDocType, sourceDocId])
  @@map("stock_ledger")
}
