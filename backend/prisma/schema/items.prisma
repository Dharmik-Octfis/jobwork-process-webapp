model Item {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  name                     String
  type                     String   @default("Goods") @db.VarChar(50)
  category                 String?
  hsnCode                  String?  @map("hsn_code")
  itemType                 String   @default("Single Item") @map("item_type") @db.VarChar(50)
  unit                     String
  sku                      String
  isSalesInfo              Boolean  @default(false) @map("is_sales_info")
  isActive                 Boolean  @default(true) @map("is_active")
  sellingPrice             Decimal? @map("selling_price") @db.Decimal(10, 2)
  salesDescription         String?  @map("sales_description")
  isPurchaseInfo           Boolean  @default(false) @map("is_purchase_info")
  costPrice                Decimal? @map("cost_price") @db.Decimal(10, 2)
  purchaseDescription      String?  @map("purchase_description")
  packaging                String?
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                String?  @map("created_by") @db.Uuid
  isDeleted                Boolean  @default(false) @map("is_deleted")
  updatedBy                String?  @map("updated_by") @db.Uuid
  customFields             Json     @default("{}") @map("custom_fields")
  /// 🔴 THE TWO TRACKING COLUMNS. Until 2026-08-12 both were dead — the item form
  /// wrote them and no backend rule read them, while the rule that mattered read a
  /// third column (`lot_tracking`) no UI could set. So a user who ticked "Batch"
  /// got an item that tracked nothing. `lot_tracking` is gone; these two are now
  /// the authority (spec I-4).
  ///
  /// `trackInventory` — is this item stocked AT ALL? False for services and for
  /// anything bought straight to expense: no opening stock, no ledger, no balance.
  trackInventory           Boolean  @default(false) @map("track_inventory")
  /// none | batch — how much batch detail the USER sees (§5.2.1). Only meaningful
  /// when `trackInventory` is true.
  ///
  /// 🔴 A BATCH IS ALWAYS CREATED INTERNALLY whatever this says — the ledger needs
  /// exactly one batch to hang every quantity on, and genealogy cannot be
  /// reconstructed later. `none` means the user never SEES a batch field and
  /// opening stock is a bulk quantity; the system still mints the number behind it.
  /// Use it for thread, buttons, dye chemicals, packing tape — forcing a batch
  /// number there is how a system gets abandoned. `batch` additionally makes at
  /// least one batch row REQUIRED wherever stock comes in.
  inventoryTracking        String   @default("none") @map("inventory_tracking") @db.VarChar(20)
  openingStock             Decimal? @map("opening_stock") @db.Decimal(10, 2)
  openingStockValuePerUnit Decimal? @map("opening_stock_value_per_unit") @db.Decimal(10, 2)
  frontImage               Json?    @map("front_image")
  images                   Json?    @default("[]")
  rearImage                Json?    @map("rear_image")

  /// 🔴 THE stocking unit, as a real FK. `unit` above is the legacy free-text
  /// string it was backfilled from and is still what the item form shows; this is
  /// what the stock ledger and every batch reference.
  ///
  /// Nullable because the backfill matched `unit` against
  /// `units_of_measurement.unit_name` per organization and some rows had no match
  /// (typos, units never defined). An unmatched item simply has no stocking uom
  /// yet — jobwork screens ask for one before they will move its stock, which is a
  /// loud, fixable failure rather than a silently wrong balance.
  ///
  /// One item has exactly ONE stocking unit (§5.1). If the unit of a thing changes
  /// because the thing changed, it is a DIFFERENT item — cloth (METER) and shirt
  /// (PCS) are two items, not one item with two units.
  stockingUomId String? @map("stocking_uom_id") @db.Uuid

  /// raw | semi_finished | finished | consumable | scrap | service — what role the
  /// item plays in production. Filters the lookups on the jobwork screens.
  nature String @default("raw") @db.VarChar(20)

  /// The route a new job order for this item starts from. A plain uuid, NOT an FK:
  /// `routes` does not exist until Sprint 2, and adding the constraint then is one
  /// line. Nothing reads it yet.
  defaultRouteId String? @map("default_route_id") @db.Uuid

  /// Rows where THIS item is the composite — its own recipe.
  recipeComponents      CompositeItemComponent[] @relation("CompositeRecipe")
  /// Rows where THIS item is a component — every composite that uses it.
  usedInComposites      CompositeItemComponent[] @relation("CompositeUsage")
  assembliesAsComposite ItemAssembly[]           @relation("ItemAssemblyComposite")
  assemblyLines         ItemAssemblyLine[]       @relation("ItemAssemblyLineItem")

  activities         ItemActivity[]
  openingStockRows   ItemOpeningStockRow[]
  createdByUser      User?                 @relation("ItemCreatedBy", fields: [createdBy], references: [id])
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser      User?                 @relation("ItemUpdatedBy", fields: [updatedBy], references: [id])
  stockingUom        UnitOfMeasurement?    @relation("ItemStockingUom", fields: [stockingUomId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  batches            Batch[]
  ledgerEntries      StockLedgerEntry[]

  /// The one single-item header relation left, and it is deliberate: CALC+,
  /// nullable, derived from step 1 for the list page, never consulted to decide
  /// anything. The issue and receipt equivalents went on 2026-08-12.
  jobOrderInputs JobOrder[] @relation("JobOrderInputItem")

  /// Multi-item documents (domain §5.7) — one row per item, which is where every
  /// per-item total is summed from.
  routeStepInputRows     RouteStepInput[]     @relation("RouteStepInputItem")
  routeStepOutputRows    RouteStepOutput[]    @relation("RouteStepOutputItem")
  jobOrderStepInputRows  JobOrderStepInput[]  @relation("JobOrderStepInputItem")
  jobOrderStepOutputRows JobOrderStepOutput[] @relation("JobOrderStepOutputItem")
  jobIssueLineItems      JobIssueLine[]       @relation("JobIssueLineItem")
  jobReceiptOutputRows   JobReceiptOutput[]   @relation("JobReceiptOutputRowItem")

  @@map("items")
}

model UnitOfMeasurement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  unitName       String       @map("unit_name")
  uqc            String       @default("OTH")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  symbol         String
  unitPrecision  Int          @default(2) @map("unit_precision")
  createdByUser  User?        @relation("UomCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?        @relation("UomUpdatedBy", fields: [updatedBy], references: [id])

  stockedItems  Item[]             @relation("ItemStockingUom")
  batches       Batch[]            @relation("BatchUom")
  ledgerEntries StockLedgerEntry[] @relation("StockLedgerUom")

  jobOrderInputUoms JobOrder[] @relation("JobOrderInputUom")

  routeStepInputUoms      RouteStepInput[]     @relation("RouteStepInputUom")
  routeStepOutputUoms     RouteStepOutput[]    @relation("RouteStepOutputUom")
  jobOrderStepInputUoms   JobOrderStepInput[]  @relation("JobOrderStepInputUom")
  jobOrderStepOutputUoms  JobOrderStepOutput[] @relation("JobOrderStepOutputUom")
  jobIssueLineUoms        JobIssueLine[]       @relation("JobIssueLineUom")
  jobReceiptOutputRowUoms JobReceiptOutput[]   @relation("JobReceiptOutputRowUom")

  compositeComponentRows CompositeItemComponent[] @relation("CompositeComponentUom")
  itemAssemblies         ItemAssembly[]           @relation("ItemAssemblyCompositeUom")
  itemAssemblyLines      ItemAssemblyLine[]       @relation("ItemAssemblyLineUom")

  @@unique([organizationId, unitName])
  @@map("units_of_measurement")
}

model ItemCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  parentId       String?  @map("parent_id") @db.Uuid
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  parent   ItemCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryToCategory")

  createdByUser User?        @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, name, parentId])
  @@map("item_categories")
}

model ItemActivity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  title         String   @db.VarChar(255)
  description   String?
  performedBy   String?  @map("performed_by") @db.VarChar(255)
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUser User?    @relation("ItemActivityCreatedBy", fields: [createdBy], references: [id])
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedByUser User?    @relation("ItemActivityUpdatedBy", fields: [updatedBy], references: [id])

  @@map("item_activities")
}

/// 🔴 THE OPENING-STOCK DOCUMENT — what the user DECLARED, per item × location.
/// It is not a balance and must never be read as one.
///
/// Opening stock is a posted document like every other (Zoho Inventory, Odoo and
/// ERPNext all model it this way): the document is kept so it can be shown and
/// corrected, and the BALANCE is always `SUM(qty_in − qty_out)` off the ledger.
/// `openingStockValuePerUnit` earns its place because it is a rate somebody
/// typed — the ledger stores the resulting value, not the rate that produced it.
///
/// ⚠️ Two things were removed on 2026-08-13 because they duplicated the ledger:
///
///   - a `batches` JSONB array, holding a second copy of rows that already exist
///     in `batches` — with no batch id in it, so once a batch was split or
///     consumed the two could never be reconciled. It had already diverged in
///     dev: 3 elements against 10 real batches. Batch detail is READ BACK from
///     `batches` joined to its `opening` ledger rows, which is what
///     `readOpeningStockFromLedger` has always done correctly.
///   - `item_location_stocks`, a per-item × per-location `stock_on_hand` cache
///     that only this one screen ever wrote. A balance cache is normal in ERPs
///     (ERPNext's `Bin`), but only when EVERY posting maintains it in the same
///     transaction as the ledger row. Nothing else in this app touched it, so it
///     was correct until the first job issue and silently wrong forever after.
///     If one is ever needed, it belongs inside `postMovement`, never here.
model ItemOpeningStockRow {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  itemId                   String   @map("item_id") @db.Uuid
  locationId               String   @map("location_id") @db.Uuid
  /// (18,4) to match `stock_ledger.qty_in`. They were (10,2): a quantity the
  /// ledger held as 12.3456 came back from here as 12.35, so the document and the
  /// movement it produced disagreed on paper.
  openingStock             Decimal? @map("opening_stock") @db.Decimal(18, 4)
  openingStockValuePerUnit Decimal? @map("opening_stock_value_per_unit") @db.Decimal(18, 4)
  customFields             Json     @default("{}") @map("custom_fields")
  isDeleted                Boolean  @default(false) @map("is_deleted")
  createdBy                String?  @map("created_by") @db.Uuid
  updatedBy                String?  @map("updated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item          Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location      Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ItemOpeningStockRowCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("ItemOpeningStockRowUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, itemId, locationId])
  @@index([organizationId, itemId])
  @@index([organizationId, locationId])
  @@map("item_opening_stock_rows")
}
