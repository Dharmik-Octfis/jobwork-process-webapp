// Generator + datasource only. Models live in the sibling domain files
// (tenant.prisma, authz.prisma, …) — architecture §3.4.
//
// Prisma 7 note: the connection URL is NOT declared here. It is read from
// `DATABASE_URL` in `prisma.config.ts`.

generator client {
  provider      = "prisma-client"
  output        = "../../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}
