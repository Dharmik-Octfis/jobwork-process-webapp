model VendorAddress {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  addressType   String   @map("address_type") @db.VarChar(50)
  attention     String?  @db.VarChar(255)
  country       String?  @db.VarChar(100)
  street1       String?
  street2       String?
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  pinCode       String?  @map("pin_code") @db.VarChar(20)
  phone         String?  @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  isDeleted     Boolean  @default(false) @map("is_deleted")
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdByUser User?    @relation("VendorAddressCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("VendorAddressUpdatedBy", fields: [updatedBy], references: [id])
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_addresses")
}

model PurchaseOrder {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  vendorId           String                  @map("vendor_id") @db.Uuid
  deliveryType       String                  @default("Location") @map("delivery_type") @db.VarChar(50)
  deliveryLocationId String?                 @map("delivery_location_id") @db.Uuid
  deliveryCustomerId String?                 @map("delivery_customer_id") @db.Uuid
  poNumber           String                  @map("po_number") @db.VarChar(100)
  date               DateTime                @map("po_date") @db.Date
  deliveryDate       DateTime?               @map("delivery_date") @db.Date
  paymentTerms       String?                 @map("payment_terms") @db.VarChar(100)
  subTotal           Decimal                 @default(0) @map("sub_total") @db.Decimal(15, 2)
  totalAmount        Decimal                 @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes              String?
  status             String                  @default("Draft") @db.VarChar(50)
  customFields       Json                    @default("{}") @map("custom_fields")
  isDeleted          Boolean                 @default(false) @map("is_deleted")
  createdBy          String?                 @map("created_by") @db.Uuid
  updatedBy          String?                 @map("updated_by") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  locationId         String?                 @map("location_id") @db.Uuid
  documents          Json?                   @default("[]") @map("attachments")
  termsAndConditions String?                 @map("terms_and_conditions")
  activities         PurchaseOrderActivity[]
  comments           PurchaseOrderComment[]
  lineItems          PurchaseOrderItem[]
  createdByUser      User?                   @relation("PoCreatedBy", fields: [createdBy], references: [id])
  deliveryCustomer   Customer?               @relation(fields: [deliveryCustomerId], references: [id])
  deliveryLocation   Location?               @relation(fields: [deliveryLocationId], references: [id])
  location           Location?               @relation("PoSourceLocation", fields: [locationId], references: [id])
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser      User?                   @relation("PoUpdatedBy", fields: [updatedBy], references: [id])
  vendor             Vendor                  @relation(fields: [vendorId], references: [id])
  bills              Bill[]                  @relation("PoToBill")

  @@unique([organizationId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId    String        @map("purchase_order_id") @db.Uuid
  itemId             String        @map("item_id") @db.Uuid
  itemPoStatus       String?       @map("item_po_status") @db.VarChar(50)
  linkedSalesOrderId String?       @map("linked_sales_order_id") @db.Uuid
  totalWeight        Decimal?      @map("total_weight") @db.Decimal(15, 2)
  costPrice          Decimal?      @map("cost_price") @db.Decimal(15, 2)
  quantity           Decimal       @default(1) @db.Decimal(15, 2)
  rate               Decimal       @default(0) @db.Decimal(15, 2)
  discountPercentage Decimal?      @map("discount_percentage") @db.Decimal(5, 2)
  discount           Decimal?      @map("discount_amount") @db.Decimal(15, 2)
  itemTotal          Decimal       @default(0) @map("amount") @db.Decimal(15, 2)
  projectId          String?       @map("project_id") @db.Uuid
  reportingTags      Json?         @map("reporting_tags")
  customFields       Json          @default("{}") @map("custom_fields")
  isDeleted          Boolean       @default(false) @map("is_deleted")
  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUser      User?         @relation("PoItemCreatedBy", fields: [createdBy], references: [id])
  item               Item          @relation(fields: [itemId], references: [id])
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  updatedByUser      User?         @relation("PoItemUpdatedBy", fields: [updatedBy], references: [id])

  @@map("purchase_order_items")
}

