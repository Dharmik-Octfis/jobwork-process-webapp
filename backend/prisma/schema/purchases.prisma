model Bill {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  vendorId       String         @map("vendor_id") @db.Uuid
  locationId     String?        @map("location_id") @db.Uuid
  billNumber     String         @map("bill_number") @db.VarChar(100)
  billDate       DateTime       @map("bill_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  paymentTerms       String?        @map("payment_terms") @db.VarChar(100)
  subTotal           Decimal        @default(0) @map("sub_total") @db.Decimal(15, 2)
  totalAmount        Decimal        @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes              String?
  status             String         @default("Draft") @db.VarChar(50)
  customFields       Json           @default("{}") @map("custom_fields")
  isDeleted          Boolean        @default(false) @map("is_deleted")
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents          Json?          @default("[]") @map("attachments")
  termsAndConditions String?        @map("terms_and_conditions")
  activities     BillActivity[]
  comments       BillComment[]
  lineItems      BillItem[]
  createdByUser  User?          @relation("BillCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  location       Location?      @relation("BillLocation", fields: [locationId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?          @relation("BillUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  sourcePoId     String?        @map("source_po_id") @db.Uuid
  sourcePo       PurchaseOrder? @relation("PoToBill", fields: [sourcePoId], references: [id])

  @@map("bills")
}

model BillItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId             String   @map("bill_id") @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  quantity           Decimal  @default(1) @db.Decimal(15, 2)
  rate               Decimal  @default(0) @db.Decimal(15, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  discount           Decimal? @map("discount_amount") @db.Decimal(15, 2)
  itemTotal          Decimal  @default(0) @map("amount") @db.Decimal(15, 2)
  customFields       Json     @default("{}") @map("custom_fields")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUser      User?    @relation("BillItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  item               Item     @relation(fields: [itemId], references: [id])
  bill               Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  updatedByUser      User?    @relation("BillItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("bill_items")
}

