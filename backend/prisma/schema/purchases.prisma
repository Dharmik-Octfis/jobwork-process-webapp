model Vendor {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  contactNumber            String                @map("vendor_number") @db.VarChar(50)
  email                    String?               @map("email_address") @db.VarChar(255)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companyName              String?               @map("company_name") @db.VarChar(255)
  currency                 String?               @db.VarChar(10)
  contactName              String                @default("") @map("display_name") @db.VarChar(255)
  mobile                   String?               @map("mobile_phone") @db.VarChar(50)
  paymentTerms             String?               @map("payment_terms") @db.VarChar(100)
  primaryContactFirstName  String?               @map("primary_contact_first_name") @db.VarChar(100)
  primaryContactLastName   String?               @map("primary_contact_last_name") @db.VarChar(100)
  primaryContactSalutation String?               @map("primary_contact_salutation") @db.VarChar(20)
  status                   String                @default("active") @db.VarChar(20)
  phone                    String?               @map("work_phone") @db.VarChar(50)
  createdBy                String?               @map("created_by") @db.Uuid
  isDeleted                Boolean               @default(false) @map("is_deleted")
  updatedBy                String?               @map("updated_by") @db.Uuid
  customFields             Json                  @default("{}") @map("custom_fields")
  notes                    String?
  /// material_supplier | job_worker | broker | transporter | general
  ///
  /// Multi-valued: one vendor is often both a supplier and a jobworker. This is
  /// what filters the lookups — the Issue screen must offer job workers only, the
  /// PO's broker field brokers only (domain doc §7.1). Empty means "not yet
  /// classified", which is what every existing row is after the migration; nothing
  /// treats that as an error.
  vendorTypes              String[]              @default([]) @map("vendor_types")
  purchaseOrders           PurchaseOrder[]
  bills                    Bill[]
  locations                Location[]            @relation("LocationVendor")
  activities               VendorActivity[]
  addresses                VendorAddress[]
  comments                 VendorComment[]
  contactPersons           VendorContactPerson[]
  createdByUser            User?                 @relation("VendorCreatedBy", fields: [createdBy], references: [id])
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser            User?                 @relation("VendorUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, contactNumber])
  @@map("vendors")
}

model VendorContactPerson {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  salutation    String?  @db.VarChar(20)
  firstName     String?  @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  email         String?  @map("email_address") @db.VarChar(255)
  phone         String?  @map("work_phone") @db.VarChar(50)
  mobile        String?  @map("mobile_phone") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  isDeleted     Boolean  @default(false) @map("is_deleted")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdByUser User?    @relation("VendorContactPersonCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("VendorContactPersonUpdatedBy", fields: [updatedBy], references: [id])
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_contact_persons")
}

