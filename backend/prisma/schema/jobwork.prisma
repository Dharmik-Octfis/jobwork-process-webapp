/// Jobwork — the operation master.
///
/// Sprint 1 ships only `Process`. Routes, job orders, issues and receipts land in
/// Sprints 2–4 and belong in THIS file (see docs/JOBWORK_IMPLEMENTATION_PLAN.md §8.1).
///
/// A Process is what someone DOES to material: dyeing, printing, cutting,
/// stitching. It is a small per-org master, but two of its flags are read by the
/// issue and receipt screens later and decide what those screens are even allowed
/// to offer — so they exist from the first migration rather than being bolted on:
///
///   itemChanges          the thing that comes back is a DIFFERENT item (cloth → shirt).
///                        Domain doc §5.1: a changed unit means a changed item, never
///                        a conversion factor.
///   rateBasis            how the processor charges (§9.2). Decides which quantity the
///                        cost is multiplied by, so it cannot be inferred later.
///
/// ⚠️ `preservesPackaging` was a third, and went with package-level tracking on
/// 2026-08-12. It existed only to decide unit-wise vs bulk receipt; with quantity
/// granularity stopping at the batch, every receipt is bulk and the flag could only
/// ever hold one meaningful value.
///
/// ⚠️ `requiresSingleBatch` was a fourth — shade-batch matching (§5.2.4) — and went
/// on 2026-08-17. Do not re-add it without re-reading why it failed. It came off the
/// Process form alongside `preservesPackaging`, but `writableFields()` kept spreading
/// it into BOTH create and update, so every subsequent edit of a process silently
/// reset it to false: the rule could not be set, seen, or deliberately cleared. Worse,
/// the guard ran over `resolvedLines` — AFTER FIFO allocation splits one request line
/// across batches — so on a non-batch-tracked item it refused a quantity the user had
/// no picker for and no way to enter differently. If shade matching is ever wanted
/// back, it belongs on the ITEM or the job order step, checked against what the user
/// actually picked, not against what the allocator chose.
model Process {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(150)
  /// Optional short code the shop floor uses on paperwork. Free text — nothing
  /// derives meaning from it, exactly like `Batch.supplierBatchRef`.
  code           String? @db.VarChar(50)
  description    String?

  /// true when the output is a different item from the input (§5.1).
  itemChanges Boolean @default(false) @map("item_changes")

  /// per_issued_unit | per_received_unit
  /// `per_kg` and `lump_sum` were dropped 2026-08-10 and their stored values
  /// rewritten to per_issued_unit: neither had a number this system holds — there
  /// is no weight to multiply, and a lump sum billed in full against a step that
  /// received nothing.
  rateBasis String @default("per_issued_unit") @map("rate_basis") @db.VarChar(30)

  /// Default over-receipt allowance, in percent. Nullable: "no default" is a real
  /// answer and is not the same as 0 (which means "no tolerance at all").
  defaultTolerancePct Decimal? @map("default_tolerance_pct") @db.Decimal(6, 3)

  /// `defaultIssueUomId` / `defaultReceiveUomId` were dropped 2026-08-10. A step
  /// transacts in its ITEMS' stocking units (§5.1) — an org-wide default on the
  /// operation master was a guess about one item, and `jobOrders.service.ts`
  /// applying it is what let a challan and the ledger describe one movement in two
  /// different units.

  /// Retained per CLAUDE.md's default block, but nothing writes it: `process` left
  /// `ENTITY_TYPES` on 2026-08-10, so the operation master has no custom fields.
  /// Values saved before then are still here rather than destroyed.
  customFields Json    @default("{}") @map("custom_fields")
  isDeleted    Boolean @default(false) @map("is_deleted")
  createdBy    String? @map("created_by") @db.Uuid
  updatedBy    String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ProcessCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("ProcessUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  /// A soft-deleted row still occupies this key (CLAUDE.md). The service therefore
  /// REVIVES a soft-deleted process on a name collision rather than 409-ing —
  /// "Dyeing" deleted last month must be creatable again.
  /// Route steps and job order steps both point here. The job order step ALSO
  /// carries `processNameSnapshot`, because this relation is for reporting and
  /// the snapshot is what prints (§2.4).
  routeSteps    RouteStep[]    @relation("RouteStepProcess")
  jobOrderSteps JobOrderStep[] @relation("JobOrderStepProcess")

  @@unique([organizationId, name])
  @@map("processes")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Process Routes
// ---------------------------------------------------------------------------

/// A reusable sequence of operations: grey → dyeing → printing → finishing.
///
/// A route is a TEMPLATE and nothing else. It is read exactly once, when a job
/// order is created, and never again — `JobOrderStep` below is a full snapshot,
/// not a link (field-sources doc §2.4). Editing a route must never rewrite a job
/// order already running against it, because the rate on a released order is a
/// number someone agreed with a processor.
model Route {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(150)
  code           String? @db.VarChar(50)
  description    String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("RouteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("RouteUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  steps     RouteStep[]
  jobOrders JobOrder[]

  @@unique([organizationId, name])
  @@map("routes")
}

/// One operation inside a route, with the defaults a job order step copies.
///
/// Every default here is NULLABLE on purpose. The default chain (§2.5) runs
/// Process master → route step → job order step → the document, and each level
/// only overrides what it actually knows: a route that says nothing about rate
/// must fall through to the process, not overwrite it with a zero.
model RouteStep {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised from the route so this table carries its own RLS policy,
  /// exactly like `job_issue_lines` below.
  organizationId String @map("organization_id") @db.Uuid
  routeId        String @map("route_id") @db.Uuid

  /// Position in the sequence, 1-based. Renumbered on drag, which is why it is
  /// an ordinary column and not part of the primary key.
  seq       Int
  processId String @map("process_id") @db.Uuid

  /// vendor | customer | internal. `customer` covers the case where the party who
  /// owns the goods also performs a step on them (inward jobwork, shape D).
  processorType String @default("vendor") @map("processor_type") @db.VarChar(20)

  /// The default processor. A PLAIN uuid with no FK, for the same reason as
  /// `batches.owner_party_id`: it points at `vendors` OR `customers` depending on
  /// `processorType`, so a constraint covering one of the two would enforce
  /// nothing on the other. The service checks it against the org instead.
  processorId String? @map("processor_id") @db.Uuid

  /// Where an `internal` step happens — a `work_centre` location.
  workCentreLocationId String? @map("work_centre_location_id") @db.Uuid

  rate      Decimal? @db.Decimal(18, 4)
  rateBasis String?  @map("rate_basis") @db.VarChar(30)

  /// ⚠️ `issueItemId` / `issueUomId` / `receiveItemId` / `receiveUomId` were
  /// dropped on 2026-08-12 (plan §12.1, Migration B). They held the principal
  /// input and primary output as a projection of `RouteStepInput` /
  /// `RouteStepOutput`, which is where those items live now — one item per row,
  /// because a step consumes a SET and produces a SET (§5.7).

  /// 🔴 PRIMARY OUTPUT ÷ PRINCIPAL INPUT, and nothing else.
  ///
  /// Since §5.7 a step has several of each, and one ratio cannot relate three
  /// inputs to two outputs — so it relates exactly one pair, and every other
  /// output carries an expected quantity of its own (`RouteStepOutput`, and
  /// `JobOrderStepOutput.expectedQty`). Its whole job is to fill that one number
  /// in.
  ///
  /// An expectation used to flag variance — 🔴 NEVER a conversion factor, which
  /// would invent or destroy stock (§6.3).
  expectedYield Decimal? @map("expected_yield") @db.Decimal(18, 6)
  /// The step's default over-issue allowance. `RouteStepInput` carries no
  /// per-item override — a template holds policy, and which item needs a looser
  /// tolerance is a per-run answer (`JobOrderStepInput.tolerancePct`).
  tolerancePct  Decimal? @map("tolerance_pct") @db.Decimal(6, 3)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route         Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  process       Process      @relation("RouteStepProcess", fields: [processId], references: [id])
  workCentre    Location?    @relation("RouteStepWorkCentre", fields: [workCentreLocationId], references: [id])
  createdByUser User?        @relation("RouteStepCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("RouteStepUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  inputs  RouteStepInput[]
  outputs RouteStepOutput[]

  /// A FULL index — a soft-deleted step would still occupy its seq. That is why
  /// the service hard-replaces a route's steps on edit rather than soft-deleting
  /// them; see processRoutes.service.ts for why that is safe here and nowhere
  /// else in this codebase.
  @@unique([routeId, seq])
  @@index([organizationId, routeId])
  @@map("route_steps")
}

/// 🔴 THE BILL OF MATERIALS, on the template side (domain doc §5.7).
///
/// A step consumes a SET of items — stitching takes panels AND thread AND
/// buttons — so this replaces `RouteStep.issueItemId/issueUomId`. Those columns
/// survive until Migration B only so the old build keeps running while this one
/// rolls out; nothing reads them after that.
///
/// No quantity here on purpose. A route is a template and has no idea how much
/// anyone will run through it; `JobOrderStepInput.plannedQty` is where a number
/// first means something.
model RouteStepInput {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised for its own RLS policy, exactly like `route_steps` itself.
  organizationId String @map("organization_id") @db.Uuid
  routeStepId    String @map("route_step_id") @db.Uuid

  /// Display order only. Inputs are a set — nothing depends on which is first
  /// except the job order form, which seeds step 1's first row from the header.
  seq    Int
  itemId String  @map("item_id") @db.Uuid
  /// Snapshot of the item's stocking uom. One item, one stocking unit (§5.1), so
  /// this is forced from the item and never chosen.
  uomId  String? @map("uom_id") @db.Uuid

  /// 🔴 A DEFAULT quantity, not a ratio (added 2026-08-10).
  ///
  /// The template side deliberately had no quantity at all: a route does not know
  /// how much anyone will run through it. What it CAN know is the amount this org
  /// usually runs, and retyping "5000 M grey, 12 CONE thread" on every job order
  /// built from the same route is the data entry this replaces. The job order
  /// copies it into `job_order_step_inputs.planned_qty` once, where it is edited
  /// like any other row (§2.4) — nothing here is read again after that copy.
  ///
  /// It is NOT consumption per unit of output. Scaling it by an order quantity
  /// would need a ratio between 2,910 PCS and 80 KG, which does not exist, and no
  /// conversion exists anywhere in this system (§5.1).
  ///
  /// NULL means the template says nothing, which is the normal case and is why
  /// this is nullable rather than defaulted to 0.
  plannedQty Decimal? @map("planned_qty") @db.Decimal(18, 4)

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeStep     RouteStep          @relation(fields: [routeStepId], references: [id], onDelete: Cascade)
  item          Item               @relation("RouteStepInputItem", fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("RouteStepInputUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("RouteStepInputCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("RouteStepInputUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  /// One row per item. Listing an item twice is a data-entry slip, not a second
  /// requirement — the quantities would have to be added anyway.
  @@unique([routeStepId, itemId])
  @@index([organizationId, routeStepId])
  @@map("route_step_inputs")
}

/// What the template expects a step to produce. Same shape as the input side.
model RouteStepOutput {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  routeStepId    String @map("route_step_id") @db.Uuid

  seq    Int
  itemId String  @map("item_id") @db.Uuid
  uomId  String? @map("uom_id") @db.Uuid

  /// 🔴 Exactly one output per step carries this. It absorbs the step's whole
  /// cost; every other output is a by-product carrying an explicit value that is
  /// deducted from this one's share (§9.2.1). Apportioning by quantity is not
  /// available — 2,910 PCS and 80 KG have no ratio between them.
  isPrimary Boolean @default(false) @map("is_primary")

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeStep     RouteStep          @relation(fields: [routeStepId], references: [id], onDelete: Cascade)
  item          Item               @relation("RouteStepOutputItem", fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("RouteStepOutputUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("RouteStepOutputCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("RouteStepOutputUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([routeStepId, itemId])
  @@index([organizationId, routeStepId])
  @@map("route_step_outputs")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Job Orders
// ---------------------------------------------------------------------------

/// One run of work: this much of this item, through these steps.
///
/// 🔴 `sourceSalesOrderId` is deliberately ABSENT, not stubbed (plan §1.2). A
/// nullable uuid costs one migration the day Sales Orders ship; a column nothing
/// writes is a field every form has to explain in the meantime.
model JobOrder {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// `NumberSequence('job_order')`, allocated inside the save transaction — never
  /// when the form opens, or every abandoned form burns a number (§2.2).
  jobOrderNumber String @map("job_order_number") @db.VarChar(50)

  /// When the work was ordered. Editable, because paperwork arrives late.
  orderDate  DateTime  @default(now()) @map("order_date") @db.Timestamptz(6)
  targetDate DateTime? @map("target_date") @db.Timestamptz(6)

  /// 🔴 CALC+, and no longer a field anyone fills in.
  ///
  /// A step consumes a SET of items (§5.7), so a single item and quantity on the
  /// header could only ever name one of them — and naming one of three on the
  /// document that owns all three is worse than naming none. The form dropped
  /// both; the service now DERIVES them from step 1's first consumed row, purely
  /// so the list page has something to show and old orders keep reading.
  ///
  /// Nullable since 2026-08-07: a step that lists no inputs yet has nothing to
  /// derive from, and a required column would force a value to be invented.
  inputItemId String?  @map("input_item_id") @db.Uuid
  inputUomId  String?  @map("input_uom_id") @db.Uuid
  inputQty    Decimal? @map("input_qty") @db.Decimal(18, 4)

  routeId           String? @map("route_id") @db.Uuid
  /// 🔴 The frozen name, which is what prints. The FK above is for joins and
  /// reporting; this is what an old job order keeps showing after the route is
  /// renamed or deleted (§2.4). Store BOTH — that is the rule, not a choice.
  routeNameSnapshot String? @map("route_name_snapshot") @db.VarChar(150)

  /// own | customer. Decides valuation, invoice type, and 🔴 which batches the issue
  /// picker may even offer — one customer's goods must never be issued into
  /// another's order (§5.3).
  ownership    String  @default("own") @db.VarChar(20)
  ownerPartyId String? @map("owner_party_id") @db.Uuid

  /// draft | in_progress | completed | short_closed | cancelled.
  ///
  /// CALC+ (field-sources §4.3): stored, but only ever written by
  /// `jobOrders.status.ts` recomputing it from the steps underneath. Never taken
  /// from a request body — a status a user can type is a status that disagrees
  /// with the documents it claims to summarise.
  status String @default("draft") @db.VarChar(30)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputItem     Item?              @relation("JobOrderInputItem", fields: [inputItemId], references: [id])
  inputUom      UnitOfMeasurement? @relation("JobOrderInputUom", fields: [inputUomId], references: [id])
  route         Route?             @relation(fields: [routeId], references: [id])
  createdByUser User?              @relation("JobOrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("JobOrderUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  steps    JobOrderStep[]
  issues   JobIssue[]
  receipts JobReceipt[]

  @@unique([organizationId, jobOrderNumber])
  @@index([organizationId, status])
  @@map("job_orders")
}

/// 🔴 A FULL SNAPSHOT OF A ROUTE STEP, NEVER A LIVE LINK.
///
/// Everything the route knew is copied here at creation, and the route is never
/// read again (§2.4). That is what lets a route be edited — or deleted — while
/// twenty job orders keep running against the version that existed when they were
/// released. The `processId` FK survives for reporting; `processNameSnapshot` is
/// what prints.
///
/// A job order with NO route at all is normal: the steps are simply typed by
/// hand. That is what "fully flexible" means in the domain doc, and it is why
/// nothing in this table is required to have come from a route.
model JobOrderStep {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobOrderId     String @map("job_order_id") @db.Uuid

  seq                 Int
  processId           String @map("process_id") @db.Uuid
  /// Frozen at creation. A process renamed from "Dyeing" to "Reactive Dyeing"
  /// must not retitle the challans already printed against this step.
  processNameSnapshot String @map("process_name_snapshot") @db.VarChar(150)

  processorType         String  @default("vendor") @map("processor_type") @db.VarChar(20)
  processorId           String? @map("processor_id") @db.Uuid
  processorNameSnapshot String? @map("processor_name_snapshot") @db.VarChar(255)
  workCentreLocationId  String? @map("work_centre_location_id") @db.Uuid

  rate      Decimal? @db.Decimal(18, 4)
  rateBasis String?  @map("rate_basis") @db.VarChar(30)

  /// ⚠️ `issueItemId` / `issueUomId` / `receiveItemId` / `receiveUomId` were
  /// dropped on 2026-08-12 (plan §12.1, Migration B). They mirrored the principal
  /// input and the primary output; those live in `JobOrderStepInput` /
  /// `JobOrderStepOutput`, one row per item (§5.7). Everything that read them —
  /// the Issue dialog, the receipt prefill, the Overview's availability and
  /// wastage figures — reads row 1 of the relevant list instead.

  /// 🔴 Primary output ÷ principal input — see `RouteStep.expectedYield`. It
  /// fills in `JobOrderStepOutput.expectedQty` for the primary output alone;
  /// by-products carry their own expected quantity, because no single ratio can
  /// relate three inputs to two outputs.
  expectedYield Decimal? @map("expected_yield") @db.Decimal(18, 6)
  /// The step's default over-issue allowance. `JobOrderStepInput.tolerancePct`
  /// overrides it per item — fabric at 3% beside thread at 25%.
  tolerancePct  Decimal? @map("tolerance_pct") @db.Decimal(6, 3)

  /// How much this step is expected to consume. Step 1 inherits the job order's
  /// input quantity; later steps are planned from the previous step's expected
  /// yield, and stay editable because a plan is a plan.
  plannedInputQty Decimal? @map("planned_input_qty") @db.Decimal(18, 4)

  /// pending | issued | partially_received | completed | short_closed.
  /// CALC+, like `JobOrder.status` — recomputed from issues and receipts, never
  /// sent by a client.
  status String @default("pending") @db.VarChar(30)

  /// A step completed via the manual Complete button.
  isCompleted Boolean @default(false) @map("is_completed")

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOrder      JobOrder     @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  process       Process      @relation("JobOrderStepProcess", fields: [processId], references: [id])
  workCentre    Location?    @relation("JobOrderStepWorkCentre", fields: [workCentreLocationId], references: [id])
  createdByUser User?        @relation("JobOrderStepCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("JobOrderStepUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  issues   JobIssue[]
  receipts JobReceipt[]
  inputs   JobOrderStepInput[]
  outputs  JobOrderStepOutput[]

  @@unique([jobOrderId, seq])
  @@index([organizationId, jobOrderId])
  @@map("job_order_steps")
}

/// 🔴 WHAT THE STEP CONSUMES. One row per item (domain doc §5.7).
///
/// Replaces `JobOrderStep.issueItemId/issueUomId`, which could only ever name
/// one. Stitching consumes panels, thread and buttons in one operation, on one
/// challan, from one processor — splitting that into three steps would multiply
/// the paperwork by the bill of materials and let three step statuses disagree
/// about whether stitching happened.
model JobOrderStepInput {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobOrderStepId String @map("job_order_step_id") @db.Uuid

  seq    Int
  itemId String  @map("item_id") @db.Uuid
  uomId  String? @map("uom_id") @db.Uuid

  /// How much of THIS item the step expects to consume, in THIS item's unit.
  /// Per item, because there is no single number that covers metres, cones and
  /// pieces at once.
  plannedQty Decimal? @map("planned_qty") @db.Decimal(18, 4)

  /// Over-issue allowance for THIS item, overriding the step's. Fabric may allow
  /// 3% while thread allows 25% — small quantities vary more, and one percentage
  /// across three items is either too tight for one or meaningless for another.
  ///
  /// NULL means "use the step's", which is why it is nullable rather than
  /// defaulted: 0 is a real answer meaning no tolerance at all, and a default
  /// would make that indistinguishable from "not set" (§2.5).
  tolerancePct Decimal? @map("tolerance_pct") @db.Decimal(6, 3)

  /// 🔴 true when no EARLIER step produces this item, so it is drawn from stock.
  ///
  /// Computed once at save and stored rather than re-derived, because the
  /// Overview and the Issue dialog both label it and neither should re-walk the
  /// whole chain to render a row. It is a classification, never a rejection
  /// (§6.4): thread comes from the godown, not from the operation above, and a
  /// rule that refused it would refuse most real steps.
  fromStock Boolean @default(false) @map("from_stock")

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  step          JobOrderStep       @relation(fields: [jobOrderStepId], references: [id], onDelete: Cascade)
  item          Item               @relation("JobOrderStepInputItem", fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("JobOrderStepInputUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("JobOrderStepInputCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("JobOrderStepInputUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  plannedBatches JobOrderStepInputBatch[]

  @@unique([jobOrderStepId, itemId])
  @@index([organizationId, jobOrderStepId])
  @@map("job_order_step_inputs")
}

/// 🔴 WHICH BATCHES THE PLANNER MEANT TO USE. A NOTE, NOT A RESERVATION.
///
/// Recorded at job order creation so the Issue dialog can pre-fill instead of
/// asking the same question twice. It moves NO stock, and it holds nothing back:
/// `getAvailableBatches` reads the ledger and does not subtract these rows, so two
/// job orders may both plan the same 100 metres and the second only finds out when
/// it tries to issue. That is a deliberate 2026-08-17 decision — a real reservation
/// means netting these out of every availability query and releasing them on
/// cancel, short-close and delete, which is a different and much larger feature
/// (`Item.committedStock` is still hardcoded 0 for the same reason).
///
/// Every major ERP binds batches at PICKING, not at planning, precisely because an
/// unenforced plan-time allocation reads as a guarantee. So the issue picker warns
/// when a batch is spoken for elsewhere rather than pretending it is free.
///
/// 🔴 A ROW IS A BATCH AT A LOCATION, like every other batch reference in this
/// codebase — one batch can sit in two godowns of a dispatch site with two
/// independent balances, and the plan has to say which one it meant.
model JobOrderStepInputBatch {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  jobOrderStepInputId String @map("job_order_step_input_id") @db.Uuid

  batchId    String @map("batch_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  /// In the INPUT ROW's unit, which is the batch's stocking unit (§5.1). These sum
  /// to the input's `plannedQty`; the form refuses to save while they do not.
  qty Decimal @db.Decimal(18, 4)

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stepInput     JobOrderStepInput @relation(fields: [jobOrderStepInputId], references: [id], onDelete: Cascade)
  batch         Batch             @relation("JobOrderStepInputBatchBatch", fields: [batchId], references: [id])
  location      Location          @relation("JobOrderStepInputBatchLocation", fields: [locationId], references: [id])
  createdByUser User?             @relation("JobOrderStepInputBatchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?             @relation("JobOrderStepInputBatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([jobOrderStepInputId, batchId, locationId])
  @@index([organizationId, jobOrderStepInputId])
  /// "What else is planning to use this batch" — the issue picker's warning.
  @@index([organizationId, batchId])
  @@map("job_order_step_input_batches")
}

/// What the step is expected to produce. The receipt is what says what actually
/// came back — these are the plan, and a receipt may add rows the plan never had.
model JobOrderStepOutput {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobOrderStepId String @map("job_order_step_id") @db.Uuid

  seq    Int
  itemId String  @map("item_id") @db.Uuid
  uomId  String? @map("uom_id") @db.Uuid

  expectedQty Decimal? @map("expected_qty") @db.Decimal(18, 4)

  /// 🔴 Exactly one per step. See `RouteStepOutput.isPrimary`.
  isPrimary Boolean @default(false) @map("is_primary")

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  step          JobOrderStep       @relation(fields: [jobOrderStepId], references: [id], onDelete: Cascade)
  item          Item               @relation("JobOrderStepOutputItem", fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("JobOrderStepOutputUom", fields: [uomId], references: [id])
  createdByUser User?              @relation("JobOrderStepOutputCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("JobOrderStepOutputUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([jobOrderStepId, itemId])
  @@index([organizationId, jobOrderStepId])
  @@map("job_order_step_outputs")
}

// ---------------------------------------------------------------------------
// Sprint 3 — Issue (the challan out)
// ---------------------------------------------------------------------------

/// Material leaving for a processor. The document the goods physically travel
/// with, which is why it cannot be deferred: they cannot legally move without it.
///
/// 🔴 Every party detail is stored TWICE — the FK for joins, a snapshot for print
/// (§2.4). Sunrise Dyers moves premises in October; reprinting August's challan
/// must show the August address, because that is where the goods went and that is
/// what the e-way bill will be compared against.
model JobIssue {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  jobOrderId     String @map("job_order_id") @db.Uuid
  jobOrderStepId String @map("job_order_step_id") @db.Uuid

  /// `NumberSequence('job_issue')`. It is printed on a challan, so it is
  /// allocated on save and never reused.
  challanNumber String   @map("challan_number") @db.VarChar(50)
  issueDate     DateTime @default(now()) @map("issue_date") @db.Timestamptz(6)

  processorType            String  @default("vendor") @map("processor_type") @db.VarChar(20)
  processorId              String? @map("processor_id") @db.Uuid
  processorNameSnapshot    String? @map("processor_name_snapshot") @db.VarChar(255)
  /// One text blob, not five columns. It is never queried, only printed, and the
  /// shape of an Indian address varies enough that parsing it back out would be a
  /// project of its own.
  processorAddressSnapshot String? @map("processor_address_snapshot")
  processorGstinSnapshot   String? @map("processor_gstin_snapshot") @db.VarChar(20)

  /// Stock moves OUT of source and IN to destination — one axis, so
  /// godown-to-processor and godown-to-godown are the same operation (§5.4). The
  /// destination is auto-provisioned the first time a processor is used.
  sourceLocationId      String @map("source_location_id") @db.Uuid
  destinationLocationId String @map("destination_location_id") @db.Uuid

  /// ⚠️ `itemId` / `uomId` were dropped on 2026-08-12. They held the PRINCIPAL
  /// item — one of the three a challan carries — and every screen that showed
  /// them named one item and silently hid the rest. The items live on
  /// `JobIssueLine`, one row per batch, which is where every per-item total is
  /// already summed from.

  /// Rework goes back to the SAME step, with the attempt counted so a second pass
  /// is not mistaken for over-issue (Sprint 4).
  isRework  Boolean @default(false) @map("is_rework")
  attemptNo Int     @default(1) @map("attempt_no")

  /// ⚠️ `vehicleNo`, `lrNo`, `lrDate` and `ewayBillNo` were DROPPED on 2026-08-10
  /// along with the dialog's Transport section — nothing captured them and the
  /// challan no longer prints them. `transporterId` survives the cut only because
  /// nothing wrote it either way; it is unused and free to go with the next
  /// migration that touches this table.
  transporterId String? @map("transporter_id") @db.Uuid

  /// The sum of the lines, denormalised. Cheap to keep correct — the lines are
  /// written once, in this document's own transaction, and never edited — and it
  /// keeps the list page off a per-row aggregate.
  totalQty Decimal @default(0) @map("total_qty") @db.Decimal(18, 4)

  /// Why an issue past `plannedInputQty × (1 + tolerance)` was allowed. A
  /// tolerance breach that leaves no trace is a tolerance that does not exist
  /// (§5.4).
  toleranceOverrideReason String? @map("tolerance_override_reason")

  /// issued | partially_received | closed | cancelled. CALC+.
  status String @default("issued") @db.VarChar(30)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOrder       JobOrder     @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  step           JobOrderStep @relation(fields: [jobOrderStepId], references: [id], onDelete: Cascade)
  sourceLocation Location     @relation("JobIssueSource", fields: [sourceLocationId], references: [id])
  destination    Location     @relation("JobIssueDestination", fields: [destinationLocationId], references: [id])
  createdByUser  User?        @relation("JobIssueCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser  User?        @relation("JobIssueUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  lines        JobIssueLine[]
  receiptLines JobReceiptLine[]

  @@unique([organizationId, challanNumber])
  @@index([organizationId, jobOrderStepId])
  /// The Overview reads an order's whole feed by `jobOrderId`, not step by step.
  /// Without this the only usable prefix is `organization_id` and the read scans
  /// the org's every challan — free at 58 rows, the page at 100k.
  @@index([organizationId, jobOrderId])
  @@map("job_issues")
}

/// One batch on a challan.
///
/// Granularity stops here. Package-level (per-taka) lines went on 2026-08-12 — a
/// line names a batch and a quantity, which is exactly what every balance groups
/// by, so no read ever has to join its way back to a coarser row.
model JobIssueLine {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobIssueId     String @map("job_issue_id") @db.Uuid

  /// 🔴 THE ITEM LIVES HERE, and only here (domain doc §5.7).
  ///
  /// One challan carries fabric, thread and buttons together — it is one physical
  /// movement to one processor, so it is one document. The `JobIssue.itemId`
  /// header copy went on 2026-08-12; every per-item total downstream — tolerance,
  /// step completion, the Overview — already summed from this column.
  ///
  /// NOT NULL since that change: the service always wrote it, so the constraint
  /// is the guarantee catching up with the code.
  itemId String  @map("item_id") @db.Uuid
  uomId  String? @map("uom_id") @db.Uuid

  batchId String @map("batch_id") @db.Uuid

  /// 🔴 WHICH GODOWN THIS LINE PHYSICALLY LEFT (2026-08-14).
  ///
  /// The header's `sourceLocationId` is the DISPATCH POINT — the address printed
  /// on the Rule 55 challan. This is where the goods actually were, which is not
  /// the same question once a site has more than one godown: a mill with three
  /// racks under one roof loads a single vehicle from all three, and forcing one
  /// challan per rack invents paperwork that does not match the lorry.
  ///
  /// 🔴 CONSTRAINED, NOT FREE. Every line must sit in the same DISPATCH SITE as
  /// the header — the root of the location hierarchy (`Location.parentId`). Two
  /// godowns under one site share an address, so one challan is honest; two
  /// genuinely separate premises have two addresses and legally need two
  /// challans. The rule is derived from how the customer modelled their
  /// locations, so nothing has to be configured, and a flat setup with no parents
  /// behaves exactly as it did before this column existed.
  sourceLocationId String @map("source_location_id") @db.Uuid

  qty Decimal @db.Decimal(18, 4)

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobIssue       JobIssue           @relation(fields: [jobIssueId], references: [id], onDelete: Cascade)
  item           Item               @relation("JobIssueLineItem", fields: [itemId], references: [id])
  uom            UnitOfMeasurement? @relation("JobIssueLineUom", fields: [uomId], references: [id])
  batch          Batch              @relation("JobIssueLineBatch", fields: [batchId], references: [id])
  sourceLocation Location           @relation("JobIssueLineSource", fields: [sourceLocationId], references: [id])
  createdByUser  User?              @relation("JobIssueLineCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser  User?              @relation("JobIssueLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  receiptLines JobReceiptLine[]

  @@index([organizationId, jobIssueId])
  @@index([organizationId, sourceLocationId])
  @@map("job_issue_lines")
}

// ---------------------------------------------------------------------------
// Sprint 4 — Receipt (goods back), and the reason master it needs
// ---------------------------------------------------------------------------

/// Why material was rejected. A small per-org master, and it has to BE a master:
/// free text cannot be GROUPED, and "which defect is costing us the most" is the
/// whole point of recording a reason at all (plan §2).
model RejectionReason {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(150)
  code           String? @db.VarChar(50)
  description    String?

  /// ours | theirs — whether this defect usually points at us or the processor. A
  /// DEFAULT the receive dialog pre-fills, never a rule: the same defect can be
  /// either, and what gets billed is decided per receipt line.
  defaultResponsibility String? @map("default_responsibility") @db.VarChar(20)

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("RejectionReasonCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("RejectionReasonUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  receiptLines   JobReceiptLine[]
  receiptOutputs JobReceiptOutput[] @relation("JobReceiptOutputReason")

  @@unique([organizationId, name])
  @@map("rejection_reasons")
}

/// Goods coming back from a processor.
///
/// ⚠️ `mode` (unit_wise | bulk) went with package-level tracking on 2026-08-12,
/// along with `Process.preservesPackaging` that decided it. Every receipt is a
/// quantity against a batch now, so the distinction had nothing left to express.
model JobReceipt {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  jobOrderId     String @map("job_order_id") @db.Uuid
  jobOrderStepId String @map("job_order_step_id") @db.Uuid

  receiptNumber String   @map("receipt_number") @db.VarChar(50)
  receiptDate   DateTime @default(now()) @map("receipt_date") @db.Timestamptz(6)

  processorType         String  @default("vendor") @map("processor_type") @db.VarChar(20)
  processorId           String? @map("processor_id") @db.Uuid
  processorNameSnapshot String? @map("processor_name_snapshot") @db.VarChar(255)

  /// ⚠️ `outputItemId` / `outputUomId` were dropped on 2026-08-12. They named
  /// which row the six totals below describe — always the PRIMARY output, which
  /// `JobReceiptOutput.isPrimary` already says. A receipt returns shirts AND
  /// rejects AND offcuts; one item on the header could only ever name one.
  ///
  /// The REQUEST still accepts `outputItemId`: it is how a client naming no
  /// `outputs` list says what came back, and it feeds `resolveOutputs`. That is
  /// an input, not storage.

  /// Where the goods landed — ours again, so a godown.
  locationId String @map("location_id") @db.Uuid

  /// ⚠️ REDEFINED 2026-08-21: the FIRST accepted / rework batch of the PRIMARY
  /// output, not "the" batch. An output row may now land in several batches, and
  /// `job_receipt_output_batches` is the complete list.
  ///
  /// Kept because the receipt screen and the rework re-issue read them as a
  /// shortcut, and because dropping a column costs a destructive migration for no
  /// gain. 🔴 Never iterate these two to answer "which batches did this receipt
  /// touch" — that question skipped every by-product's batch for as long as they
  /// were the only answer available. Read the child table.
  outputBatchId String? @map("output_batch_id") @db.Uuid
  /// A SEPARATE batch for the rework pieces, always. Merging them into the accepted
  /// batch loses the piece count rework has to be measured by (plan §7).
  reworkBatchId String? @map("rework_batch_id") @db.Uuid

  /// The disposition split, summed. The four MUST add up to `totalReceivedQty` —
  /// the service refuses the save otherwise, and that one check is what makes a
  /// separate "Rejection Note" document unnecessary (§6.4).
  totalIssuedQty   Decimal @default(0) @map("total_issued_qty") @db.Decimal(18, 4)
  totalReceivedQty Decimal @default(0) @map("total_received_qty") @db.Decimal(18, 4)
  totalAcceptedQty Decimal @default(0) @map("total_accepted_qty") @db.Decimal(18, 4)
  totalReworkQty   Decimal @default(0) @map("total_rework_qty") @db.Decimal(18, 4)
  totalScrapQty    Decimal @default(0) @map("total_scrap_qty") @db.Decimal(18, 4)
  /// Sent straight back to the processor. 🔴 It never entered our stock, so NO
  /// ledger row is written for it (§6.4) — a row here would create quantity that
  /// was never physically ours.
  totalReturnedQty Decimal @default(0) @map("total_returned_qty") @db.Decimal(18, 4)

  /// posted | cancelled. A cancellation posts REVERSING ledger rows and flips
  /// this; it never deletes anything (inventory.prisma).
  status String @default("posted") @db.VarChar(30)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOrder      JobOrder     @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  step          JobOrderStep @relation(fields: [jobOrderStepId], references: [id], onDelete: Cascade)
  location      Location     @relation("JobReceiptLocation", fields: [locationId], references: [id])
  outputBatch   Batch?       @relation("JobReceiptOutputBatch", fields: [outputBatchId], references: [id])
  reworkBatch   Batch?       @relation("JobReceiptReworkBatch", fields: [reworkBatchId], references: [id])
  createdByUser User?        @relation("JobReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?        @relation("JobReceiptUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  lines        JobReceiptLine[]
  outputs      JobReceiptOutput[]
  outputBatches JobReceiptOutputBatch[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, jobOrderStepId])
  /// Same reason as `job_issues` — the Overview's feed is per ORDER.
  @@index([organizationId, jobOrderId])
  @@map("job_receipts")
}

/// 🔴 WHAT CAME BACK. One row per item (domain doc §5.7).
///
/// The receipt now has TWO child lists and they are different lengths: what was
/// consumed (`JobReceiptLine`, keyed to the challan lines it closes) and what was
/// returned (this). Cutting consumes one fabric and returns panels, offcuts and
/// waste; stitching consumes three items and returns two. One table holding both
/// would leave half its columns null on every row, and neither sum check could
/// then add up its own rows.
///
/// The disposition split lives HERE rather than on the consumption row, because
/// "2,880 accepted" is a statement about shirts, not about the panels that went
/// out.
model JobReceiptOutput {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobReceiptId   String @map("job_receipt_id") @db.Uuid

  seq    Int
  itemId String  @map("item_id") @db.Uuid
  uomId  String? @map("uom_id") @db.Uuid

  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  /// The four MUST sum to `receivedQty`, per row. That single check is what makes
  /// a separate "Rejection Note" document unnecessary (§6.2) — two documents can
  /// disagree about how much came back; one row cannot disagree with itself.
  acceptedQty Decimal @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  reworkQty   Decimal @default(0) @map("rework_qty") @db.Decimal(18, 4)
  scrapQty    Decimal @default(0) @map("scrap_qty") @db.Decimal(18, 4)
  /// Handed straight back at the gate. 🔴 It never entered our stock, so NO ledger
  /// row is written for it — a row here would create quantity that was never ours.
  returnedQty Decimal @default(0) @map("returned_qty") @db.Decimal(18, 4)

  /// 🔴 Exactly one output per receipt. It absorbs the pot — consumed value plus
  /// the process charge — less whatever the by-products were given (§9.2.1).
  isPrimary Boolean @default(false) @map("is_primary")

  /// By-products only: what this output is worth. NULL on the primary, which
  /// takes the remainder. Default zero is the honest answer rather than a
  /// placeholder — offcuts carry no cost until somebody sells them, and the
  /// surviving primary should carry the cost of the whole operation.
  valueShare Decimal? @map("value_share") @db.Decimal(18, 4)

  /// ⚠️ REDEFINED 2026-08-21: the FIRST batch of each kind on this row. `batches`
  /// below is the complete list — a row may land in several, and a row may top up
  /// a batch an earlier receipt created rather than create one.
  outputBatchId String? @map("output_batch_id") @db.Uuid
  reworkBatchId String? @map("rework_batch_id") @db.Uuid

  reasonId       String? @map("reason_id") @db.Uuid
  /// ours | theirs.
  responsibility String? @db.VarChar(20)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobReceipt    JobReceipt         @relation(fields: [jobReceiptId], references: [id], onDelete: Cascade)
  item          Item               @relation("JobReceiptOutputRowItem", fields: [itemId], references: [id])
  uom           UnitOfMeasurement? @relation("JobReceiptOutputRowUom", fields: [uomId], references: [id])
  outputBatch   Batch?             @relation("JobReceiptOutputRowBatch", fields: [outputBatchId], references: [id])
  reworkBatch   Batch?             @relation("JobReceiptOutputRowReworkBatch", fields: [reworkBatchId], references: [id])
  reason        RejectionReason?   @relation("JobReceiptOutputReason", fields: [reasonId], references: [id])
  createdByUser User?              @relation("JobReceiptOutputCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?              @relation("JobReceiptOutputUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  batches JobReceiptOutputBatch[]

  @@index([organizationId, jobReceiptId])
  @@map("job_receipt_outputs")
}

/// 🔴 THE BATCHES ONE RETURNED ITEM LANDED IN. One row per (output, batch).
///
/// Until 2026-08-21 an output row created exactly ONE accepted batch and one
/// rework batch, which forced two lies on anyone whose delivery did not match
/// that shape: a dyer returning three dye lots in one consignment had to file
/// three receipts or merge three lots under one label, and a second delivery of
/// the SAME lot could only ever become a second batch with a duplicate reference.
///
/// A row is one of two things, and `isNewBatch` is what tells them apart:
///   · a batch this receipt CREATED — the normal case, a physically new thing
///     coming back from a processor with no number of its own;
///   · a top-up of a batch that already existed — the second half of a split
///     delivery, continuing the lot rather than cloning its label.
///
/// 🔴 There is no `value` column and there must not be. Batch value is derived
/// from the ledger (inventory.prisma, decision 1); the `produce` row this row
/// corresponds to carries it, and a copy here could only ever disagree.
model JobReceiptOutputBatch {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Denormalised from the parent. Cancellation has to find EVERY batch a
  /// receipt touched in one read — the guard it feeds used to look at the
  /// header's two columns only, which silently skipped every by-product's batch.
  jobReceiptId       String @map("job_receipt_id") @db.Uuid
  jobReceiptOutputId String @map("job_receipt_output_id") @db.Uuid

  seq Int

  /// accepted | rework
  ///
  /// 🔴 The two NEVER share a batch. Rework keeps its own batch so the re-issue
  /// can send back only the pieces that failed, and merging it into the accepted
  /// batch loses the piece count rework is measured by (plan §7).
  kind String @db.VarChar(20)

  batchId String  @map("batch_id") @db.Uuid
  qty     Decimal @db.Decimal(18, 4)

  /// Did THIS receipt create the batch, or add to one that already existed?
  ///
  /// 🔴 Cancellation needs the difference. Reversing a batch you created undoes a
  /// birth; reversing a top-up undoes a deposit into something that outlives the
  /// receipt. The ledger reversal is the same either way — it replays by
  /// `sourceDocId` — but the "has this moved on" guard is not.
  isNewBatch Boolean @default(true) @map("is_new_batch")

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobReceipt       JobReceipt       @relation(fields: [jobReceiptId], references: [id], onDelete: Cascade)
  jobReceiptOutput JobReceiptOutput @relation(fields: [jobReceiptOutputId], references: [id], onDelete: Cascade)
  batch            Batch            @relation("JobReceiptOutputBatchBatch", fields: [batchId], references: [id])
  createdByUser    User?            @relation("JobReceiptOutputBatchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser    User?            @relation("JobReceiptOutputBatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, jobReceiptId])
  @@index([organizationId, batchId])
  @@index([organizationId, jobReceiptOutputId])
  @@map("job_receipt_output_batches")
}

/// What this receipt consumed — one row per issue line it closes.
///
/// The four disposition columns live on the LINE, not the header, because a
/// receipt that closes several challan lines has to say which line each rejected
/// quantity belongs to (§6.2). It cannot be reconstructed from header totals
/// afterwards.
model JobReceiptLine {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobReceiptId   String @map("job_receipt_id") @db.Uuid

  /// Which issue, and which line of it, this closes. Nullable because a bulk
  /// receipt spanning several issues has no single line to point at.
  jobIssueId     String? @map("job_issue_id") @db.Uuid
  jobIssueLineId String? @map("job_issue_line_id") @db.Uuid

  issuedQty   Decimal @default(0) @map("issued_qty") @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  acceptedQty Decimal @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  reworkQty   Decimal @default(0) @map("rework_qty") @db.Decimal(18, 4)
  scrapQty    Decimal @default(0) @map("scrap_qty") @db.Decimal(18, 4)
  returnedQty Decimal @default(0) @map("returned_qty") @db.Decimal(18, 4)

  reasonId       String? @map("reason_id") @db.Uuid
  /// ours | theirs. Drives whether rework is re-charged or done free, and the
  /// vendor scorecard that comes later.
  responsibility String? @db.VarChar(20)

  remarks String?

  customFields Json     @default("{}") @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobReceipt    JobReceipt       @relation(fields: [jobReceiptId], references: [id], onDelete: Cascade)
  jobIssue      JobIssue?        @relation(fields: [jobIssueId], references: [id])
  jobIssueLine  JobIssueLine?    @relation(fields: [jobIssueLineId], references: [id])
  reason        RejectionReason? @relation(fields: [reasonId], references: [id])
  createdByUser User?            @relation("JobReceiptLineCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?            @relation("JobReceiptLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, jobReceiptId])
  @@map("job_receipt_lines")
}
