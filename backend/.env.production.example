# Copy to `.env.production` and fill in real values.
#
# This file IS committed. `.env.production` is NOT — it holds the real
# production secrets, and `scripts/build-app-config.mjs` reads it to generate
# `backend/app-config.json` at deploy time.
#
# Every key here is pushed to AppSail as an environment variable. The Catalyst
# console's Configuration tab is NOT a source of truth: `catalyst deploy`
# overwrites it with whatever this file produces. Add a variable here, not there.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Relative to the app root at runtime. The bundle must actually contain this
# file — `backend/certs/` is committed for exactly this reason.
DATABASE_SSL_CA_PATH="./certs/rds-ap-south-1-bundle.pem"

# ── Auth ────────────────────────────────────────────────────────────────────
# Must differ from the dev secrets in `.env`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32-plus-random-bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-me-with-32-plus-random-bytes"
JWT_REFRESH_TTL="7d"

# ── Email (SMTP — ZeptoMail) ────────────────────────────────────────────────
SMTP_HOST="smtp.zeptomail.com"
SMTP_PORT=587
# Literal string "emailapikey" — not an address. ZeptoMail authenticates by token.
SMTP_USER="emailapikey"
# ZeptoMail console -> Mail Agents -> SMTP -> Send Mail token
SMTP_PASS="your-zeptomail-send-mail-token"
# Must be on a domain verified in ZeptoMail, or the send is rejected
SMTP_FROM="noreply@octfis.com"
SMTP_FROM_NAME="Jobwork Support"
# ZeptoMail template API — SMTP cannot render saved templates, so OTP delivery
# uses the API. Token is the same SMTP_PASS Send Mail token.
ZEPTO_API_URL="api.zeptomail.com/"
# ZeptoMail console -> Mail Agents -> Templates -> copy Template key
ZEPTO_EMAIL_VERIFY_TEMPLATE_KEY="your-zeptomail-template-key"
# Template key for the organization member-invitation email
ZEPTO_INVITE_TEMPLATE_KEY="your-zeptomail-invite-template-key"
# Value for the template's {{product_name}} merge field
ZEPTO_PRODUCT_NAME="Jobwork"

# ── Object storage (Catalyst Stratus) ───────────────────────────────────────
# Consumed by src/lib/storage.ts. All optional — leave blank and the app still
# boots; only an actual upload/download fails (loudly) until these are set.
# Catalyst console -> Settings -> Project Settings -> General
CATALYST_PROJECT_ID="your-catalyst-project-id"
# ZAID — the Catalyst "portal" id. Read it from `.catalystrc` (projects[].domain.id)
# or from the hosted login page's sign-in iframe URL (the `portal=`/`PROJECT_ID=`
# value in `/accounts/p/<ZAID>/signin`). It is NOT printed by the CLI or Settings.
CATALYST_PROJECT_KEY="your-zaid"
# "Development" or "Production" — must match the Catalyst environment you target
CATALYST_ENVIRONMENT="Development"
# API Console -> Self Client -> Client Secret tab
CATALYST_CLIENT_ID="your-oauth-client-id"
CATALYST_CLIENT_SECRET="your-oauth-client-secret"
# Generated once via the OAuth grant-token flow. Self Client -> Generate Code with
# scope: ZohoCatalyst.buckets.READ,ZohoCatalyst.buckets.objects.CREATE,
# ZohoCatalyst.buckets.objects.READ,ZohoCatalyst.buckets.objects.UPDATE,
# ZohoCatalyst.buckets.objects.DELETE  — then exchange the grant token
# (grant_type=authorization_code) for the refresh_token in the response.
CATALYST_REFRESH_TOKEN="your-oauth-refresh-token"
# Name of the Stratus bucket every upload lands in by default
CATALYST_STRATUS_BUCKET="your-bucket-name"

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# The web bundle calls the API at `/api` on its own origin, so cross-origin
# rules never fire in production. This stays at the default for local parity.
CORS_ORIGINS="http://localhost:5173"
