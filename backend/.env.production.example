# Copy to `.env.production` and fill in real values.
#
# This file IS committed. `.env.production` is NOT — it holds the real
# production secrets, and `scripts/build-app-config.mjs` reads it to generate
# `backend/app-config.json` at deploy time.
#
# Every key here is pushed to AppSail as an environment variable. The Catalyst
# console's Configuration tab is NOT a source of truth: `catalyst deploy`
# overwrites it with whatever this file produces. Add a variable here, not there.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Relative to the app root at runtime. The bundle must actually contain this
# file — `backend/certs/` is committed for exactly this reason.
DATABASE_SSL_CA_PATH="./certs/rds-ap-south-1-bundle.pem"

# ── Auth ────────────────────────────────────────────────────────────────────
# Must differ from the dev secrets in `.env`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32-plus-random-bytes"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-me-with-32-plus-random-bytes"
JWT_REFRESH_TTL="7d"

# ── Email (SMTP — ZeptoMail) ────────────────────────────────────────────────
SMTP_HOST="smtp.zeptomail.com"
SMTP_PORT=587
# Literal string "emailapikey" — not an address. ZeptoMail authenticates by token.
SMTP_USER="emailapikey"
# ZeptoMail console -> Mail Agents -> SMTP -> Send Mail token
SMTP_PASS="your-zeptomail-send-mail-token"
# Must be on a domain verified in ZeptoMail, or the send is rejected
SMTP_FROM="noreply@octfis.com"
SMTP_FROM_NAME="Jobwork Support"
# ZeptoMail template API — SMTP cannot render saved templates, so OTP delivery
# uses the API. Token is the same SMTP_PASS Send Mail token.
ZEPTO_API_URL="api.zeptomail.com/"
# ZeptoMail console -> Mail Agents -> Templates -> copy Template key
ZEPTO_EMAIL_VERIFY_TEMPLATE_KEY="your-zeptomail-template-key"
# Template key for the organization member-invitation email
ZEPTO_INVITE_TEMPLATE_KEY="your-zeptomail-invite-template-key"
# Value for the template's {{product_name}} merge field
ZEPTO_PRODUCT_NAME="Jobwork"

# ── Object storage (Catalyst Stratus) ───────────────────────────────────────
# Consumed by src/lib/storage.ts. All optional — leave blank and the app still
# boots; only an actual upload/download fails (loudly) until these are set.
#
# ⚠️ Prefixed `ZC_`, NOT `CATALYST_`. AppSail reserves the `CATALYST_` env
# namespace (it injects its own CATALYST_PROJECT_ID etc.) and fails the deploy
# with "environment_variables must not contain reserved keywords" if any
# CATALYST_* key is present. Keep our credentials out of that namespace.
#
# Catalyst console -> Settings -> Project Settings -> General
ZC_PROJECT_ID="your-catalyst-project-id"
# ZAID — the Catalyst "portal" id. Read it from `.catalystrc` (projects[].domain.id)
# or from the hosted login page's sign-in iframe URL (the `portal=`/`PROJECT_ID=`
# value in `/accounts/p/<ZAID>/signin`). It is NOT printed by the CLI or Settings.
ZC_PROJECT_KEY="your-zaid"
# "Development" or "Production" — must match the Catalyst environment you target
ZC_ENVIRONMENT="Development"
# API Console -> Self Client -> Client Secret tab.
#
# ⚠️ Per ACCOUNT, not per repo. Each deploy target's Zoho account is a different
# org with its own API Console, so staging's credentials are meaningless in
# production. Generate a fresh set while logged in as that target's account.
#
# ⚠️ Use YOUR data centre's domains. This account is on `in`, so:
#   api-console.zoho.in  and  accounts.zoho.in   (NOT .com — the token won't work)
ZC_CLIENT_ID="your-oauth-client-id"
ZC_CLIENT_SECRET="your-oauth-client-secret"
# Generated once via the OAuth grant-token flow. Self Client -> Generate Code with
# scope: ZohoCatalyst.buckets.READ,ZohoCatalyst.buckets.objects.CREATE,
# ZohoCatalyst.buckets.objects.READ,ZohoCatalyst.buckets.objects.UPDATE,
# ZohoCatalyst.buckets.objects.DELETE  — then exchange the grant token
# (grant_type=authorization_code) for the refresh_token in the response.
#
# ⚠️ Add the Cache scopes NOW even if ZC_CACHE_SEGMENT_ID is blank.
# `lib/catalystCache.ts` builds its SDK app from these same three variables, so
# one token covers Stratus *and* Cache — and scopes are fixed at generation time.
# Enabling the L2 cache later with a bucket-only token means redoing this whole
# flow, so append the cache/segment scopes from the Generate Code picker up front.
#
# The grant token is single-use and expires in minutes; `refresh_token` comes back
# ONLY on that first exchange. Lost it? Generate a new code, don't reuse the old.
ZC_REFRESH_TOKEN="your-oauth-refresh-token"
# Name of the Stratus bucket every upload lands in by default
ZC_STRATUS_BUCKET="your-bucket-name"
# Catalyst Cache segment id (Console -> Cache -> your segment -> id in the URL).
# OPTIONAL — leave unset to disable the shared (L2) cache entirely: the app still
# works, every lookup just falls through to Postgres. That makes it the on/off
# switch for caching in production, changeable without a deploy. The in-memory
# (L1) caches for /api/seed-data and /api/modules are unaffected by this.
ZC_CACHE_SEGMENT_ID=""

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# Public origin of THIS deployment — custom domain if it has one, otherwise the
# AppSail URL. No trailing slash.
#
# Used for ONE thing: the accept link in invitation emails
# (`invitations.service.ts` -> `${APP_URL}/invite/accept?token=`). Logo, image
# and avatar URLs are deliberately relative (`/api/storage/stream?key=`) and
# resolve against whatever origin the browser is on, so they need no config —
# don't reintroduce an env var for those. An email has no origin, so the invite
# link must be absolute.
#
# ⚠️ REQUIRED here even though nothing enforces it. `env.ts` gives APP_URL the
# dev default `http://localhost:5173`, so an unset value never errors: the email
# sends, the link is well-formed, and only the recipient discovers it points at
# a laptop.
APP_URL="https://your-app-domain.com"

# The web bundle calls the API at `/api` on its own origin, so cross-origin
# rules never fire in production. This stays at the default for local parity.
CORS_ORIGINS="http://localhost:5173"

# ── Diagnostics (optional) ──────────────────────────────────────────────────
# Shared secret for GET /api/diagnostics/latency. Unset = route not mounted,
# which is the correct steady state for production. Set it temporarily to
# measure the AppSail -> RDS round trip, then remove it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DIAGNOSTICS_TOKEN=""
