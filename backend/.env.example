# Copy to `.env` and fill in real values.
#
# This file IS committed (`.gitignore` has `!.env.example`). Never put a real
# password, secret, or hostname here — only placeholders.

# ── Database ────────────────────────────────────────────────────────────────
# RDS requires TLS: keep `sslmode=require`.
#
# The APP's connection. Once RLS is on (docs/PRISMA.md §8 "Turning RLS on") this
# must be the NON-OWNER `jobwork_app` role, not `postgres`. A table's owner is
# exempt from its own row-level security policies, so connecting as `postgres`
# here silently disables every tenant-isolation policy in the database — and
# nothing warns you. `src/db/rls.test.ts` asserts against exactly that.
DATABASE_URL="postgresql://jobwork_app:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# The MIGRATION connection, used only by the Prisma CLI (`migrate`, `db pull`).
# Must be the owner (`postgres`) — migrations run DDL, which `jobwork_app` cannot.
# Optional: falls back to DATABASE_URL when unset, which is correct before the
# RLS cutover, when one role does both jobs.
MIGRATE_DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# CA bundle that signs the database certificate. Required for RDS: unlike psql,
# node-postgres verifies the certificate, and Node does not trust Amazon's root
# CA. Download the bundle for your region from
# https://truststore.pki.rds.amazonaws.com/ — it is public, and committed.
# Leave unset for a local Postgres without TLS.
DATABASE_SSL_CA_PATH="./certs/rds-ap-south-1-bundle.pem"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32-plus-random-bytes"
JWT_ACCESS_TTL="15m"

JWT_REFRESH_SECRET="replace-me-with-32-plus-random-bytes-for-refresh"
JWT_REFRESH_TTL="7d"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public origin of this environment, used ONLY to build the accept link in
# invitation emails (`invitations.service.ts`). Everything else the API returns
# — logo/image/avatar URLs — is a relative `/api/storage/stream?key=` path that
# needs no configuration. An email has no origin to resolve a relative path
# against, so this one link has to be absolute.
#
# ⚠️ `env.ts` defaults this to the value below, so a DEPLOYED environment that
# forgets it does not error — it emails invitees a working-looking link to
# localhost. Set it per environment. No trailing slash.
APP_URL="http://localhost:5173"

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173"

# ── Email (SMTP — ZeptoMail) ────────────────────────────────────────────────
SMTP_HOST="smtp.zeptomail.com"
SMTP_PORT=587
# Literal string "emailapikey" — not an address. ZeptoMail authenticates by token.
SMTP_USER="emailapikey"
# ZeptoMail console -> Mail Agents -> SMTP -> Send Mail token
SMTP_PASS="your-zeptomail-send-mail-token"
# Must be on a domain verified in ZeptoMail, or the send is rejected
SMTP_FROM="noreply@octfis.com"
SMTP_FROM_NAME="Jobwork Support"
# ZeptoMail template API — SMTP cannot render saved templates, so OTP delivery
# uses the API. Token is the same SMTP_PASS Send Mail token.
ZEPTO_API_URL="api.zeptomail.com/"
# ZeptoMail console -> Mail Agents -> Templates -> copy Template key
ZEPTO_EMAIL_VERIFY_TEMPLATE_KEY="your-zeptomail-template-key"
# Template key for the organization member-invitation email
ZEPTO_INVITE_TEMPLATE_KEY="your-zeptomail-invite-template-key"
# Value for the template's {{product_name}} merge field
ZEPTO_PRODUCT_NAME="Jobwork"

# ── Diagnostics (optional) ──────────────────────────────────────────────────
# Shared secret for GET /api/diagnostics/latency, which measures the round-trip
# cost to Postgres from wherever the app is running. LEAVING THIS UNSET MEANS
# THE ROUTE IS NOT MOUNTED AT ALL — that is the intended default. Set it only
# while investigating latency, and unset it again afterwards.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DIAGNOSTICS_TOKEN=""
