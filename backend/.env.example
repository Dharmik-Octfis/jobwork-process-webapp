# Copy to `.env` and fill in real values.
#
# This file IS committed (`.gitignore` has `!.env.example`). Never put a real
# password, secret, or hostname here — only placeholders.

# ── Database ────────────────────────────────────────────────────────────────
# RDS requires TLS: keep `sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# CA bundle that signs the database certificate. Required for RDS: unlike psql,
# node-postgres verifies the certificate, and Node does not trust Amazon's root
# CA. Download the bundle for your region from
# https://truststore.pki.rds.amazonaws.com/ — it is public, and committed.
# Leave unset for a local Postgres without TLS.
DATABASE_SSL_CA_PATH="./certs/rds-ap-south-1-bundle.pem"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-32-plus-random-bytes"
JWT_ACCESS_TTL="15m"

JWT_REFRESH_SECRET="replace-me-with-32-plus-random-bytes-for-refresh"
JWT_REFRESH_TTL="7d"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173"

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
# Generate an App Password in your Google Account security settings
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@octfis.com"
