{
  "name": "jobwork-process-webapp",
  "version": "1.0.0",
  "description": "A web application for managing the jobwork process.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "build:web": "cd web && npm install && npm run build",
    "build:backend": "cd backend && npm install && npm run build",
    "config:appsail": "node scripts/build-app-config.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "capture:staging": "node scripts/capture-target.mjs staging",
    "capture:production": "node scripts/capture-target.mjs production",
    "deploy:appsail": "node -e \"console.error('\\n  deploy:appsail is gone — a deploy must name its target.\\n  Staging and production live under different Zoho accounts.\\n\\n    npm run deploy:staging\\n    npm run deploy:production\\n'); process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dharmik-Octfis/jobwork-process-webapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dharmik-Octfis/jobwork-process-webapp/issues"
  },
  "homepage": "https://github.com/Dharmik-Octfis/jobwork-process-webapp#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  }
}
