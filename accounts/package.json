{
  "name": "accounts",
  "version": "1.0.0",
  "description": "Identity provider — OIDC. Owns who a person is, and nothing else.",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:status": "tsx scripts/db-sync.ts status",
    "db:draft": "tsx scripts/db-sync.ts draft",
    "db:promote": "tsx scripts/db-sync.ts promote",
    "db:apply": "tsx scripts/db-sync.ts apply",
    "db:backup": "tsx scripts/db-sync.ts backup",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "db:push": "tsx scripts/db-sync.ts blocked push",
    "db:migrate": "tsx scripts/db-sync.ts blocked \"migrate dev\"",
    "test": "vitest run",
    "seed:identities": "tsx scripts/seed-identities.ts",
    "register:client": "tsx scripts/register-client.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "oidc-provider": "^9.7.0",
    "pg": "^8.16.3",
    "zeptomail": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/oidc-provider": "^9.4.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
