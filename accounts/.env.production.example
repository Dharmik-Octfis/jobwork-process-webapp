# accounts — environment template. Copy to .env.<target> and fill in.
#
# 🔴 One file per deploy target, NEVER shared. deploy/targets.json names which file
# each target uses (services.accounts.envFile). Both are git-ignored.

NODE_ENV=production

# 🔴 A DIFFERENT database from the app's. Never point this at jobwork_*.
# The service connects as a non-owner role with no DDL rights: this database holds
# password hashes and signing keys, and the running process has no business being
# able to DROP the tables they live in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/accounts?sslmode=require"
# The owner role, used by the Prisma CLI only — migrations need DDL.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/accounts?sslmode=require"
# Amazon's public CA bundle, so node-postgres can verify the RDS certificate.
DATABASE_SSL_CA_PATH="certs/rds-global-bundle.pem"

# 🔴 Baked into every token this service ever signs. Changing it later invalidates
# every outstanding token at once, so it must be a domain we own from day one —
# never a *.catalystappsail.com URL (docs/SSO_AND_IDENTITY.md §14 rule 1).
# No trailing slash: clients string-compare it against the `iss` claim.
#   production  https://accounts.octfis.com
#   staging     https://accounts-staging.octfis.com
OIDC_ISSUER="https://accounts.octfis.com"

# 🔴 Encrypts signing_keys.private_jwk at rest. Lives OUTSIDE the database it
# protects — stored alongside the ciphertext, a database dump becomes a licence to
# mint tokens for anyone, for any app, forever.
#   openssl rand -hex 32
SIGNING_KEY_SECRET="REPLACE_ME"

# Secrets for oidc-provider's own cookies, comma-separated. The first signs; the
# rest still verify, so rotation is prepend-then-drop rather than a forced logout.
#   openssl rand -hex 32
COOKIE_SECRETS="REPLACE_ME"
